  m_text: "\uB300\uCDA9 \uC5EC\uAE30\uB2E4 \uC544\uBB34 \uC18C\uB9AC\uAC00 \uB044\uC801\uAC70\uB824
    \uB193\uC740 \uB2E4\uC74C\uC5D0 \uC791\uAC8C \uD558\uACE0 \uAD6C\uC11D\uC5D0
    \uBC30\uCE58\uD558\uBA74 \uADF8\uB7F4\uB4EF\uD574 \uBCF4\uC774\uACA0\uC9C0 \uC640,
    \uC544\uBB34 \uB9D0\uC774\uB098 \uC801\uC740 \uB2E4\uC74C\uC5D0 \uBC30\uCE58\uD558\uB2C8\uAE4C
    \uC9C4\uC9DC \uBB54\uAC00 \uC788\uC5B4 \uBCF4\uC774\uC796\uC544? \uB300\uCDA9
    \uC5EC\uAE30\uB2E4 \uC544\uBB34 \uC18C\uB9AC\uAC00 \uB044\uC801\uAC70\uB824 \uB193\uC740
    \uB2E4\uC74C\uC5D0 \uC791\uAC8C \uD558\uACE0 \uAD6C\uC11D\uC5D0 \uBC30\uCE58\uD558\uBA74
