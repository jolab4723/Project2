  korLabels:
  - skillId: FighterHalfCircleSlash
    skillName: "\uBC18\uC6D0 \uBCA0\uAE30"
    skillDescription: "\uC804\uBC29 \uBC18\uC6D0(\uC0AC\uAC70\uB9AC 4, \uAC01\uB3C4
      180\uB3C4) \uBC94\uC704\uC758 \uC801\uC5D0\uAC8C 150% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution1Description: "\uACF5\uACA9 \uD310\uC815\uC5D0 \uB109\uBC31(\uBC00\uB824\uB098\uB294
      \uAC70\uB9AC 5, 0.3\uCD08)\uACFC \uAE30\uC808(3\uCD08) \uD6A8\uACFC\uAC00 \uCD94\uAC00\uB85C
      \uBD80\uC5EC\uB429\uB2C8\uB2E4."
    evolution2Description: "\uACF5\uACA9 \uBC94\uC704 \uC548\uC758 \uC801 \uD22C\uC0AC\uCCB4\uB97C
      \uBAA8\uB450 \uC81C\uAC70\uD569\uB2C8\uB2E4."
    evolution3Description: "\uD310\uC815\uC774 \uC804\uBC29 \uBC18\uC6D0\uC5D0\uC11C
      360\uB3C4 \uC6D0\uD615\uC73C\uB85C \uBC14\uB00C\uACE0, \uB20C\uB7EC\uC11C \uCD5C\uB300
      3\uCD08\uAE4C\uC9C0 \uCC28\uC9D5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCC28\uC9D5
      \uC2DC\uAC04\uC5D0 \uBE44\uB840\uD574 \uD53C\uD574\uAC00 120%~160%\uAE4C\uC9C0
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uD310\uC815 \uBC94\uC704\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: FighterLineSlam
    skillName: "\uC9C1\uC120 \uB0B4\uB824\uCC0D\uAE30"
    skillDescription: "\uC804\uBC29 \uC9C1\uC120(\uAE38\uC774 4, \uD3ED 2) \uBC94\uC704\uC758
      \uC801\uC5D0\uAC8C 200% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution1Description: "\uACF5\uACA9 \uD310\uC815\uC5D0 \uBC29\uC5B4\uB825 \uAC10\uC18C(30%,
      4\uCD08)\uC640 \uAE30\uC808(3\uCD08) \uD6A8\uACFC\uAC00 \uCD94\uAC00\uB85C
      \uBD80\uC5EC\uB429\uB2C8\uB2E4."
    evolution2Description: "\uD310\uC815 \uBC94\uC704\uAC00 \uAE38\uC774 6, \uD3ED
      3\uC73C\uB85C \uB113\uC5B4\uC9C0\uACE0, \uB9DE\uC740 \uC801\uC5D0\uAC8C \uC5D0\uC5B4\uBCF8(1.5\uCD08)
      \uD6A8\uACFC\uAC00 \uBD80\uC5EC\uB429\uB2C8\uB2E4."
    evolution3Description: "\uD310\uC815 \uBC94\uC704\uAC00 \uAE38\uC774 2, \uD3ED
      1\uB85C \uC881\uC544\uC9C0\uB294 \uB300\uC2E0 \uD53C\uD574\uB7C9\uC774 350%\uB85C
      \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uD310\uC815 \uBC94\uC704\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: FighterCursorDash
    skillName: "\uCEE4\uC11C \uB300\uC2DC"
    skillDescription: "\uCEE4\uC11C \uBC29\uD5A5\uC73C\uB85C \uC9E7\uAC8C(\uAC70\uB9AC
      4) \uB300\uC2DC\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4. \uD53C\uD574\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    evolution1Description: "\uB300\uC2DC \uC2DC\uC791\uACFC \uB3D9\uC2DC\uC5D0 0.5\uCD08\uAC04
      \uBB34\uC801 \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4."
    evolution2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 \uB300\uC2E0
      \uCD5C\uB300 2\uAC1C\uC758 \uC2A4\uD0DD\uC73C\uB85C \uAD00\uB9AC\uB429\uB2C8\uB2E4(\uC2A4\uD0DD
      1\uAC1C\uB2F9 4\uCD08\uC5D0 \uCDA9\uC804)."
    evolution3Description: "\uB300\uC2DC\uAC00 \uB05D\uB09C \uC9C1\uD6C4 4\uCD08\uAC04
      \uACF5\uACA9\uB825\uC774 20% \uC99D\uAC00\uD558\uB294 \uBC84\uD504\uAC00 \uBD80\uC5EC\uB429\uB2C8\uB2E4."
    enhancement1Description: "\uB300\uC2DC \uC774\uB3D9 \uC2DC\uAC04\uC774 55% \uAC10\uC18C\uD574
      \uB354 \uBE60\uB974\uAC8C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uB300\uC2DC \uC774\uB3D9 \uAC70\uB9AC\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: GunnerArcBuster
    skillName: "\uC544\uD06C \uBC84\uC2A4\uD130"
    skillDescription: "\uC815\uBA74\uC73C\uB85C \uD22C\uC0AC\uCCB4\uB97C \uBC1C\uC0AC\uD574
      \uC801\uACFC \uB2FF\uC73C\uBA74 \uBC18\uACBD 1 \uBC94\uC704\uC5D0 120% \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4. \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 \uB300\uC2E0
      \uCD5C\uB300 6\uAC1C\uC758 \uC2A4\uD0DD\uC73C\uB85C \uAD00\uB9AC\uB418\uBA70(\uC2A4\uD0DD
      1\uAC1C\uB2F9 4\uCD08\uC5D0 \uCDA9\uC804), \uC5F0\uC18D \uBC1C\uC0AC\uB294
      1\uCD08 \uAC04\uACA9\uC73C\uB85C \uC81C\uD55C\uB429\uB2C8\uB2E4."
    evolution1Description: "\uBCF4\uC720\uD55C \uC2A4\uD0DD\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574
      \uAE34 \uC9C1\uC120(\uAE38\uC774 12, \uD3ED 2) \uBC94\uC704\uB97C \uC989\uC2DC
      \uBA85\uC911\uC2DC\uD0B5\uB2C8\uB2E4. \uC18C\uBAA8\uD55C \uC2A4\uD0DD 1\uAC1C\uB2F9
      \uD53C\uD574\uAC00 50%\uC529 \uC99D\uAC00\uD558\uBA70(\uCD5C\uB300 6\uC2A4\uD0DD\uBD84\uAE4C\uC9C0
      \uC801\uC6A9), \uD3ED\uBC1C \uBC94\uC704 \uD53C\uD574\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    evolution2Description: "\uC2A4\uD0DD 1\uAC1C\uB85C \uC57D\uD654\uB41C \uD22C\uC0AC\uCCB4(\uD53C\uD574
      50%)\uB97C 0.1\uCD08 \uAC04\uACA9\uC73C\uB85C 3\uBC1C \uC5F0\uC18D \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
      \uD3ED\uBC1C\uD558\uC9C0 \uC54A\uACE0 \uBA85\uC911\uD55C \uB300\uC0C1 \uD558\uB098\uC5D0\uAC8C\uB9CC
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution3Description: "\uC2A4\uD0DD\uC744 2\uAC1C \uC18C\uBAA8\uD574 \uD3ED\uBC1C
      \uBC18\uACBD\uC774 3(\uAE30\uBCF8\uC758 3\uBC30)\uC73C\uB85C \uD06C\uAC8C \uB298\uC5B4\uB09C
      \uD655\uC7A5 \uD3ED\uBC1C\uD0C4\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uD53C\uD574
      \uBC30\uC728\uB3C4 250%\uB85C \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC2A4\uD0DD \uCDA9\uC804 \uC2DC\uAC04\uC774 35% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uD22C\uC0AC\uCCB4 \uC0AC\uAC70\uB9AC\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: GunnerBombThrow
    skillName: "\uD3ED\uD0C4 \uD22C\uCC99"
    skillDescription: "\uCEE4\uC11C \uC704\uCE58(\uCD5C\uB300 \uC0AC\uAC70\uB9AC
      6)\uB85C \uD3ED\uD0C4\uC744 \uD3EC\uBB3C\uC120\uC73C\uB85C \uB358\uC9D1\uB2C8\uB2E4.
      \uC801\uACFC \uB2FF\uAC70\uB098 \uCC29\uC9C0 \uD6C4 2\uCD08\uAC00 \uC9C0\uB098\uBA74
      \uBC18\uACBD 3 \uBC94\uC704\uC5D0 150% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution1Description: "\uCCAB \uD3ED\uBC1C 0.5\uCD08 \uD6C4 \uBC18\uACBD 4 \uBC94\uC704\uB85C
      2\uCC28 \uD3ED\uBC1C\uC774 \uD55C \uBC88 \uB354 \uBC1C\uC0DD\uD569\uB2C8\uB2E4(\uD53C\uD574\uB294
      \uCCAB \uD3ED\uBC1C\uC758 50%)."
    evolution2Description: "\uD3ED\uBC1C \uBC18\uACBD\uC774 4\uB85C \uB113\uC5B4\uC9C0\uACE0,
      \uB9DE\uC740 \uC801\uC5D0\uAC8C \uAE30\uC808(1\uCD08)\uC744 \uAC81\uB2C8\uB2E4.
      \uD3ED\uBC1C \uC9C0\uC810\uC5D0 5\uCD08\uAC04 \uC720\uC9C0\uB418\uB294 \uC2AC\uB85C\uC6B0
      \uC601\uC5ED\uC774 \uC0DD\uACA8 \uC548\uC5D0 \uC788\uB294 \uC801\uC758 \uC774\uB3D9\uC18D\uB3C4\uB97C
      40% \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4."
    evolution3Description: "\uD3ED\uBC1C \uBC94\uC704\uC758 \uC801\uC5D0\uAC8C 7\uCD08\uAC04
      \uB9C8\uCEE4\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4. \uB9C8\uCEE4\uAC00 \uAC78\uB9B0
      \uC801\uC740 \uBC1B\uB294 \uBAA8\uB4E0 \uD53C\uD574\uAC00 25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uB358\uC9C8 \uC218 \uC788\uB294 \uC0AC\uAC70\uB9AC\uAC00
      30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: GunnerBackstepShot
    skillName: "\uBC31\uC2A4\uD0ED \uC0F7"
    skillDescription: "\uC804\uBC29 \uC6D0\uBFD4(\uC0AC\uAC70\uB9AC 5, \uAC01\uB3C4
      90\uB3C4) \uBC94\uC704\uC758 \uC801\uC5D0\uAC8C 100% \uD53C\uD574\uB97C \uC900
      \uB4A4, \uCEE4\uC11C \uBC18\uB300 \uBC29\uD5A5(\uD6C4\uBC29)\uC73C\uB85C \uC9E7\uAC8C(\uAC70\uB9AC
      2) \uBB3C\uB7EC\uB0A9\uB2C8\uB2E4."
    evolution1Description: "\uC6D0\uBFD4 \uACF5\uACA9 \uB300\uC2E0 \uCC98\uC74C \uC704\uCE58\uC5D0
      \uB514\uCF54\uC774\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4. \uB514\uCF54\uC774\uB294
      3\uCD08 \uD6C4 \uC790\uB3D9\uC73C\uB85C \uD3ED\uBC1C\uD574 \uBC18\uACBD 3 \uBC94\uC704\uC5D0
      100% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution2Description: "\uD6C4\uBC29 \uC774\uB3D9\uACFC \uB3D9\uC2DC\uC5D0 0.3\uCD08\uAC04
      \uBB34\uC801 \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4."
    evolution3Description: "\uC6D0\uBFD4 \uACF5\uACA9\uC5D0 \uB9DE\uC740 \uC801\uC744
      \uB109\uBC31(\uBC00\uB824\uB098\uB294 \uAC70\uB9AC 3, 0.3\uCD08)\uC2DC\uD0B5\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uACF5\uACA9 \uC0AC\uAC70\uB9AC\uC640 \uD6C4\uBC29
      \uC774\uB3D9 \uAC70\uB9AC\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: FighterUltimate
    skillName: "\uAC01\uC131"
    skillDescription: "\uC790\uC2E0\uC744 \uC911\uC2EC\uC73C\uB85C \uBC18\uACBD 3
      \uBC94\uC704\uC758 \uC801\uC5D0\uAC8C 100% \uD53C\uD574\uB97C \uC8FC\uACE0,
      15\uCD08 \uB3D9\uC548 \uACF5\uACA9\uB825 30%, \uACF5\uACA9 \uC18D\uB3C4 25%,
      \uC774\uB3D9 \uC18D\uB3C4 15%, \uBC29\uC5B4\uB825 30%\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    evolution1Description: "\uACF5\uACA9 \uD310\uC815\uC5D0 \uB109\uBC31(\uBC00\uB824\uB098\uB294
      \uAC70\uB9AC 5, 0.3\uCD08)\uACFC \uAE30\uC808(3\uCD08) \uD6A8\uACFC\uAC00 \uCD94\uAC00\uB85C
      \uBD80\uC5EC\uB429\uB2C8\uB2E4."
    evolution2Description: "\uACF5\uACA9 \uBC94\uC704 \uC548\uC758 \uC801 \uD22C\uC0AC\uCCB4\uB97C
      \uBAA8\uB450 \uC81C\uAC70\uD569\uB2C8\uB2E4."
    evolution3Description: "\uD310\uC815\uC774 \uC804\uBC29 \uBC18\uC6D0\uC5D0\uC11C
      360\uB3C4 \uC6D0\uD615\uC73C\uB85C \uBC14\uB00C\uACE0, \uB20C\uB7EC\uC11C \uCD5C\uB300
      3\uCD08\uAE4C\uC9C0 \uCC28\uC9D5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCC28\uC9D5
      \uC2DC\uAC04\uC5D0 \uBE44\uB840\uD574 \uD53C\uD574\uAC00 120%~160%\uAE4C\uC9C0
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 35%
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uD310\uC815 \uBC94\uC704\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - skillId: GunnerUltimate
    skillName: "\uC735\uB2E8\uD3ED\uACA9"
    skillDescription: "\uCEE4\uC11C \uC9C0\uC810\uC744 \uC911\uC2EC\uC73C\uB85C \uBC18\uACBD
      8 \uC601\uC5ED \uC804\uCCB4\uB97C 0.5\uCD08 \uAC04\uACA9\uC73C\uB85C 3\uBC88
      \uD3ED\uACA9\uD574, \uB9E4\uBC88 120% \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution1Description: "\uBCF4\uC720\uD55C \uC2A4\uD0DD\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574
      \uAE34 \uC9C1\uC120(\uAE38\uC774 8, \uD3ED 1) \uBC94\uC704\uB97C \uC989\uC2DC
      \uBA85\uC911\uC2DC\uD0B5\uB2C8\uB2E4. \uC18C\uBAA8\uD55C \uC2A4\uD0DD 1\uAC1C\uB2F9
      \uD53C\uD574\uAC00 50%\uC529 \uC99D\uAC00\uD558\uBA70(\uCD5C\uB300 3\uC2A4\uD0DD\u5206\uAE4C\uC9C0
      \uC801\uC6A9), \uD3ED\uBC1C \uBC94\uC704 \uD53C\uD574\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    evolution2Description: "\uC2A4\uD0DD 1\uAC1C\uB85C \uC57D\uD654\uB41C \uD22C\uC0AC\uCCB4(\uD53C\uD574
      50%)\uB97C 0.1\uCD08 \uAC04\uACA9\uC73C\uB85C 3\uBC1C \uC5F0\uC18D \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
      \uD3ED\uBC1C\uD558\uC9C0 \uC54A\uACE0 \uBA85\uC911\uD55C \uB300\uC0C1 \uD558\uB098\uC5D0\uAC8C\uB9CC
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    evolution3Description: "\uC2A4\uD0DD\uC744 2\uAC1C \uC18C\uBAA8\uD574 \uD3ED\uBC1C
      \uBC18\uACBD\uC774 3(\uAE30\uBCF8\uC758 3\uBC30)\uC73C\uB85C \uD06C\uAC8C \uB298\uC5B4\uB09C
      \uD655\uC7A5 \uD3ED\uBC1C\uD0C4\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uD53C\uD574
      \uBC30\uC728\uB3C4 250%\uB85C \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement1Description: "\uD53C\uD574\uB7C9\uC774 55% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    enhancement2Description: "\uC2A4\uD0DD \uCDA9\uC804 \uC2DC\uAC04\uC774 35% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    enhancement3Description: "\uD22C\uC0AC\uCCB4 \uC0AC\uAC70\uB9AC\uAC00 30% \uC99D\uAC00\uD569\uB2C8\uB2E4."
  engLabels:
  - skillId: FighterHalfCircleSlash
    skillName: Half-Circle Slash
    skillDescription: "Deals 150% damage to enemies in a frontal half-circle (range
      4, 180\xB0)."
    evolution1Description: Adds knockback (distance 5, 0.3s) and stun (3s) to the
      attack.
    evolution2Description: Destroys all enemy projectiles within the attack range.
    evolution3Description: "The hitbox changes from a frontal half-circle to a full
      360\xB0 circle, and can be charged for up to 3 seconds by holding the key.
      Damage increases from 120% to 160% based on charge time."
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Hitbox size increases by 30%.
  - skillId: FighterLineSlam
    skillName: Line Slam
    skillDescription: Deals 200% damage to enemies in a frontal line (length 4, width
      2).
    evolution1Description: Adds defense reduction (30%, 4s) and stun (3s) to the
      attack.
    evolution2Description: The hitbox widens to length 6, width 3, and launches hit
      enemies into the air (1.5s).
    evolution3Description: The hitbox narrows to length 2, width 1, but damage greatly
      increases to 350%.
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Hitbox size increases by 30%.
  - skillId: FighterCursorDash
    skillName: Cursor Dash
    skillDescription: Dashes a short distance (4) toward the cursor direction. Deals
      no damage.
    evolution1Description: Grants 0.5 seconds of invincibility the moment the dash
      begins.
    evolution2Description: Managed by up to 2 stacks instead of a cooldown (each
      stack recharges in 4 seconds).
    evolution3Description: Immediately after the dash ends, grants a buff that increases
      attack power by 20% for 4 seconds.
    enhancement1Description: Dash travel time decreases by 55%, moving faster.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Dash travel distance increases by 30%.
  - skillId: GunnerArcBuster
    skillName: Arc Buster
    skillDescription: Fires a projectile forward that deals 120% damage in a radius
      of 1 upon contact with an enemy. Managed by up to 6 stacks instead of a cooldown
      (each stack recharges in 4 seconds), and consecutive shots are limited to a
      1-second interval.
    evolution1Description: Consumes all stacks to instantly hit a long line (length
      12, width 2). Damage increases by 50% per stack consumed (up to 6 stacks).
      No explosion damage.
    evolution2Description: Consumes 1 stack to fire 3 weakened projectiles (50% damage)
      in succession at 0.1-second intervals. They do not explode and only damage
      the single target hit.
    evolution3Description: Consumes 2 stacks to fire an expanded explosive shot with
      a greatly increased blast radius of 3 (3 times the base). Damage multiplier
      also greatly increases to 250%.
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Stack recharge time decreases by 35%.
    enhancement3Description: Projectile range increases by 30%.
  - skillId: GunnerBombThrow
    skillName: Bomb Throw
    skillDescription: Throws a bomb in an arc toward the cursor position (max range
      6). Deals 150% damage in a radius of 3 upon contact with an enemy or 2 seconds
      after landing.
    evolution1Description: 0.5 seconds after the first explosion, a second explosion
      occurs once more in a radius of 4 (damage is 50% of the first explosion).
    evolution2Description: The explosion radius widens to 4 and stuns (1s) hit enemies.
      A slow field that lasts 5 seconds appears at the explosion point, reducing
      the movement speed of enemies inside by 40%.
    evolution3Description: Applies a marker to enemies in the explosion range for
      7 seconds. Marked enemies take 25% increased damage from all sources.
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Throw range increases by 30%.
  - skillId: GunnerBackstepShot
    skillName: Backstep Shot
    skillDescription: "Deals 100% damage to enemies in a frontal cone (range 5, 90\xB0),
      then steps back a short distance (2) in the direction opposite the cursor."
    evolution1Description: Instead of the cone attack, installs a decoy at the original
      position. The decoy automatically explodes after 3 seconds, dealing 100% damage
      in a radius of 3.
    evolution2Description: Grants 0.3 seconds of invincibility at the same time as
      the backward movement.
    evolution3Description: Knocks back enemies hit by the cone attack (distance 3,
      0.3s).
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Attack range and backward movement distance increase
      by 30%.
  - skillId: FighterUltimate
    skillName: Awakening
    skillDescription: Deals 100% damage to enemies within 3 units around you, then
      increases Attack by 30%, Attack Speed by 25%, Move Speed by 15% and Defense
      by 30% for 15 seconds.
    evolution1Description: Adds knockback (distance 5, 0.3s) and stun (3s) to the
      attack.
    evolution2Description: Destroys all enemy projectiles within the attack range.
    evolution3Description: "The hitbox changes from a frontal half-circle to a full
      360\xB0 circle, and can be charged for up to 3 seconds by holding the key.
      Damage increases from 120% to 160% based on charge time."
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Cooldown decreases by 35%.
    enhancement3Description: Hitbox size increases by 30%.
  - skillId: GunnerUltimate
    skillName: Carpet Bombing
    skillDescription: Bombards the entire 8-unit radius area around the cursor 3
      times at 0.5s intervals, dealing 120% damage each time.
    evolution1Description: Consumes all held stacks to instantly hit a long line
      (length 8, width 1). Damage increases by 50% per stack consumed (up to 3 stacks),
      with no explosion area damage.
    evolution2Description: Consumes 1 stack to fire 3 weakened projectiles (50% damage)
      in succession at 0.1-second intervals. They do not explode and only damage
      the single target hit.
    evolution3Description: Consumes 2 stacks to fire an expanded explosive shot with
      a greatly increased blast radius of 3 (3 times the base). Damage multiplier
      also greatly increases to 250%.
    enhancement1Description: Damage increases by 55%.
    enhancement2Description: Stack recharge time decreases by 35%.
    enhancement3Description: Projectile range increases by 30%.
  jpnLabels:
  - skillId: FighterHalfCircleSlash
    skillName: "\u534A\u5186\u65AC\u308A"
    skillDescription: "\u524D\u65B9\u306E\u534A\u5186\u7BC4\u56F2\uFF08\u5C04\u7A0B4\u3001\u89D2\u5EA6180\u5EA6\uFF09\u306E\u6575\u306B150%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution1Description: "\u653B\u6483\u5224\u5B9A\u306B\u30CE\u30C3\u30AF\u30D0\u30C3\u30AF\uFF08\u8DDD\u96E25\u30010.3\u79D2\uFF09\u3068\u30B9\u30BF\u30F3\uFF083\u79D2\uFF09\u52B9\u679C\u304C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
    evolution2Description: "\u653B\u6483\u7BC4\u56F2\u5185\u306E\u6575\u306E\u6295\u5C04\u7269\u3092\u3059\u3079\u3066\u9664\u53BB\u3057\u307E\u3059\u3002"
    evolution3Description: "\u5224\u5B9A\u304C\u524D\u65B9\u534A\u5186\u304B\u3089360\u5EA6\u306E\u5186\u5F62\u306B\u5909\u308F\u308A\u3001\u62BC\u3057\u7D9A\u3051\u308B\u3053\u3068\u3067\u6700\u59273\u79D2\u307E\u3067\u30C1\u30E3\u30FC\u30B8\u3067\u304D\u307E\u3059\u3002\u30C1\u30E3\u30FC\u30B8\u6642\u9593\u306B\u6BD4\u4F8B\u3057\u3066\u30C0\u30E1\u30FC\u30B8\u304C120%\u301C160%\u307E\u3067\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u5224\u5B9A\u7BC4\u56F2\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: FighterLineSlam
    skillName: "\u76F4\u7DDA\u53E9\u304D\u3064\u3051"
    skillDescription: "\u524D\u65B9\u306E\u76F4\u7DDA\u7BC4\u56F2\uFF08\u9577\u30554\u3001\u5E452\uFF09\u306E\u6575\u306B200%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution1Description: "\u653B\u6483\u5224\u5B9A\u306B\u9632\u5FA1\u529B\u6E1B\u5C11\uFF0830%\u30014\u79D2\uFF09\u3068\u30B9\u30BF\u30F3\uFF083\u79D2\uFF09\u52B9\u679C\u304C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
    evolution2Description: "\u5224\u5B9A\u7BC4\u56F2\u304C\u9577\u30556\u3001\u5E453\u306B\u5E83\u304C\u308A\u3001\u547D\u4E2D\u3057\u305F\u6575\u306B\u30A8\u30A2\u30DC\u30FC\u30F3(1.5\u79D2)\u52B9\u679C\u304C\u4ED8\u4E0E\u3055\u308C\u307E\u3059\u3002"
    evolution3Description: "\u5224\u5B9A\u7BC4\u56F2\u304C\u9577\u30552\u3001\u5E451\u306B\u72ED\u304F\u306A\u308B\u4EE3\u308F\u308A\u306B\u3001\u30C0\u30E1\u30FC\u30B8\u304C350%\u307E\u3067\u5927\u5E45\u306B\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u5224\u5B9A\u7BC4\u56F2\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: FighterCursorDash
    skillName: "\u30AB\u30FC\u30BD\u30EB\u30C0\u30C3\u30B7\u30E5"
    skillDescription: "\u30AB\u30FC\u30BD\u30EB\u65B9\u5411\u3078\u77ED\u304F\uFF08\u8DDD\u96E24\uFF09\u30C0\u30C3\u30B7\u30E5\u79FB\u52D5\u3057\u307E\u3059\u3002\u30C0\u30E1\u30FC\u30B8\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    evolution1Description: "\u30C0\u30C3\u30B7\u30E5\u958B\u59CB\u3068\u540C\u6642\u306B0.5\u79D2\u9593\u7121\u6575\u72B6\u614B\u306B\u306A\u308A\u307E\u3059\u3002"
    evolution2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u306E\u4EE3\u308F\u308A\u306B\u6700\u59272\u500B\u306E\u30B9\u30BF\u30C3\u30AF\u3067\u7BA1\u7406\u3055\u308C\u307E\u3059\uFF08\u30B9\u30BF\u30C3\u30AF1\u500B\u306B\u3064\u304D4\u79D2\u3067\u30C1\u30E3\u30FC\u30B8\uFF09\u3002"
    evolution3Description: "\u30C0\u30C3\u30B7\u30E5\u7D42\u4E86\u76F4\u5F8C\u30014\u79D2\u9593\u653B\u6483\u529B\u304C20%\u5897\u52A0\u3059\u308B\u30D0\u30D5\u304C\u4ED8\u4E0E\u3055\u308C\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30C3\u30B7\u30E5\u79FB\u52D5\u6642\u9593\u304C55%\u6E1B\u5C11\u3057\u3001\u3088\u308A\u901F\u304F\u79FB\u52D5\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u30C0\u30C3\u30B7\u30E5\u79FB\u52D5\u8DDD\u96E2\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: GunnerArcBuster
    skillName: "\u30A2\u30FC\u30AF\u30D0\u30B9\u30BF\u30FC"
    skillDescription: "\u6B63\u9762\u306B\u6295\u5C04\u7269\u3092\u767A\u5C04\u3057\u3001\u6575\u306B\u547D\u4E2D\u3059\u308B\u3068\u534A\u5F841\u7BC4\u56F2\u306B120%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u306E\u4EE3\u308F\u308A\u306B\u6700\u59276\u500B\u306E\u30B9\u30BF\u30C3\u30AF\u3067\u7BA1\u7406\u3055\u308C\uFF08\u30B9\u30BF\u30C3\u30AF1\u500B\u306B\u3064\u304D4\u79D2\u3067\u30C1\u30E3\u30FC\u30B8\uFF09\u3001\u9023\u7D9A\u767A\u5C04\u306F1\u79D2\u9593\u9694\u306B\u5236\u9650\u3055\u308C\u307E\u3059\u3002"
    evolution1Description: "\u4FDD\u6709\u30B9\u30BF\u30C3\u30AF\u3092\u3059\u3079\u3066\u6D88\u8CBB\u3057\u3001\u9577\u3044\u76F4\u7DDA(\u9577\u305512\u3001\u5E452)\u7BC4\u56F2\u3092\u5373\u5EA7\u306B\u547D\u4E2D\u3055\u305B\u307E\u3059\u3002\u6D88\u8CBB\u3057\u305F\u30B9\u30BF\u30C3\u30AF1\u500B\u306B\u3064\u304D\u30C0\u30E1\u30FC\u30B8\u304C50%\u305A\u3064\u5897\u52A0\u3057(\u6700\u59276\u30B9\u30BF\u30C3\u30AF\u5206\u307E\u3067\u9069\u7528)\u3001\u7206\u767A\u7BC4\u56F2\u30C0\u30E1\u30FC\u30B8\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    evolution2Description: "\u30B9\u30BF\u30C3\u30AF1\u500B\u3067\u5F31\u4F53\u5316\u3057\u305F\u6295\u5C04\u7269\uFF08\u30C0\u30E1\u30FC\u30B850%\uFF09\u30920.1\u79D2\u9593\u9694\u30673\u767A\u9023\u7D9A\u767A\u5C04\u3057\u307E\u3059\u3002\u7206\u767A\u305B\u305A\u3001\u547D\u4E2D\u3057\u305F\u5BFE\u8C611\u4F53\u306B\u306E\u307F\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution3Description: "\u30B9\u30BF\u30C3\u30AF\u30922\u500B\u6D88\u8CBB\u3057\u3001\u7206\u767A\u534A\u5F84\u304C3\uFF08\u57FA\u672C\u306E3\u500D\uFF09\u307E\u3067\u5927\u5E45\u306B\u5E83\u304C\u3063\u305F\u62E1\u5F35\u7206\u767A\u5F3E\u3092\u767A\u5C04\u3057\u307E\u3059\u3002\u30C0\u30E1\u30FC\u30B8\u500D\u7387\u3082250%\u307E\u3067\u5927\u5E45\u306B\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u30B9\u30BF\u30C3\u30AF\u30C1\u30E3\u30FC\u30B8\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u6295\u5C04\u7269\u306E\u5C04\u7A0B\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: GunnerBombThrow
    skillName: "\u7206\u5F3E\u6295\u3052"
    skillDescription: "\u30AB\u30FC\u30BD\u30EB\u4F4D\u7F6E\uFF08\u6700\u5927\u5C04\u7A0B6\uFF09\u3078\u653E\u7269\u7DDA\u3092\u63CF\u3044\u3066\u7206\u5F3E\u3092\u6295\u3052\u307E\u3059\u3002\u6575\u306B\u63A5\u89E6\u3059\u308B\u304B\u7740\u5730\u5F8C2\u79D2\u304C\u7D4C\u904E\u3059\u308B\u3068\u3001\u534A\u5F843\u7BC4\u56F2\u306B150%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution1Description: "\u6700\u521D\u306E\u7206\u767A\u304B\u30890.5\u79D2\u5F8C\u3001\u534A\u5F844\u7BC4\u56F2\u3067\u3082\u3046\u4E00\u5EA62\u6B21\u7206\u767A\u304C\u767A\u751F\u3057\u307E\u3059\uFF08\u30C0\u30E1\u30FC\u30B8\u306F\u6700\u521D\u306E\u7206\u767A\u306E50%\uFF09\u3002"
    evolution2Description: "\u7206\u767A\u534A\u5F84\u304C4\u306B\u5E83\u304C\u308A\u3001\u547D\u4E2D\u3057\u305F\u6575\u306B\u30B9\u30BF\u30F3\uFF081\u79D2\uFF09\u3092\u4ED8\u4E0E\u3057\u307E\u3059\u3002\u7206\u767A\u5730\u70B9\u306B5\u79D2\u9593\u6301\u7D9A\u3059\u308B\u30B9\u30ED\u30FC\u9818\u57DF\u304C\u767A\u751F\u3057\u3001\u5185\u90E8\u306B\u3044\u308B\u6575\u306E\u79FB\u52D5\u901F\u5EA6\u309240%\u6E1B\u5C11\u3055\u305B\u307E\u3059\u3002"
    evolution3Description: "\u7206\u767A\u7BC4\u56F2\u306E\u6575\u306B7\u79D2\u9593\u30DE\u30FC\u30AB\u30FC\u3092\u4ED8\u4E0E\u3057\u307E\u3059\u3002\u30DE\u30FC\u30AB\u30FC\u304C\u4ED8\u3044\u305F\u6575\u306F\u53D7\u3051\u308B\u3059\u3079\u3066\u306E\u30C0\u30E1\u30FC\u30B8\u304C25%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u6295\u3052\u3089\u308C\u308B\u5C04\u7A0B\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: GunnerBackstepShot
    skillName: "\u30D0\u30C3\u30AF\u30B9\u30C6\u30C3\u30D7\u30B7\u30E7\u30C3\u30C8"
    skillDescription: "\u524D\u65B9\u5186\u9310\uFF08\u5C04\u7A0B5\u3001\u89D2\u5EA690\u5EA6\uFF09\u7BC4\u56F2\u306E\u6575\u306B100%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u305F\u5F8C\u3001\u30AB\u30FC\u30BD\u30EB\u306E\u53CD\u5BFE\u65B9\u5411\uFF08\u5F8C\u65B9\uFF09\u3078\u77ED\u304F\uFF08\u8DDD\u96E22\uFF09\u5F8C\u9000\u3057\u307E\u3059\u3002"
    evolution1Description: "\u5186\u9310\u653B\u6483\u306E\u4EE3\u308F\u308A\u306B\u5143\u306E\u4F4D\u7F6E\u306B\u30C7\u30B3\u30A4\u3092\u8A2D\u7F6E\u3057\u307E\u3059\u3002\u30C7\u30B3\u30A4\u306F3\u79D2\u5F8C\u306B\u81EA\u52D5\u7684\u306B\u7206\u767A\u3057\u3001\u534A\u5F843\u7BC4\u56F2\u306B100%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution2Description: "\u5F8C\u65B9\u79FB\u52D5\u3068\u540C\u6642\u306B0.3\u79D2\u9593\u7121\u6575\u72B6\u614B\u306B\u306A\u308A\u307E\u3059\u3002"
    evolution3Description: "\u5186\u9310\u653B\u6483\u306B\u547D\u4E2D\u3057\u305F\u6575\u3092\u30CE\u30C3\u30AF\u30D0\u30C3\u30AF\uFF08\u8DDD\u96E23\u30010.3\u79D2\uFF09\u3055\u305B\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u653B\u6483\u5C04\u7A0B\u3068\u5F8C\u65B9\u79FB\u52D5\u8DDD\u96E2\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: FighterUltimate
    skillName: "\u899A\u9192"
    skillDescription: "\u81EA\u5206\u3092\u4E2D\u5FC3\u306B\u534A\u5F843\u306E\u7BC4\u56F2\u306E\u6575\u306B100%\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u300115\u79D2\u9593
      \u653B\u6483\u529B\u304C30%\u3001\u653B\u6483\u901F\u5EA6\u304C25%\u3001\u79FB\u52D5\u901F\u5EA6\u304C15%\u3001\u9632\u5FA1\u529B\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
    evolution1Description: "\u653B\u6483\u5224\u5B9A\u306B\u30CE\u30C3\u30AF\u30D0\u30C3\u30AF\uFF08\u8DDD\u96E25\u30010.3\u79D2\uFF09\u3068\u30B9\u30BF\u30F3\uFF083\u79D2\uFF09\u52B9\u679C\u304C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
    evolution2Description: "\u653B\u6483\u7BC4\u56F2\u5185\u306E\u6575\u306E\u6295\u5C04\u7269\u3092\u3059\u3079\u3066\u9664\u53BB\u3057\u307E\u3059\u3002"
    evolution3Description: "\u5224\u5B9A\u304C\u524D\u65B9\u534A\u5186\u304B\u3089360\u5EA6\u306E\u5186\u5F62\u306B\u5909\u308F\u308A\u3001\u62BC\u3057\u7D9A\u3051\u308B\u3053\u3068\u3067\u6700\u59273\u79D2\u307E\u3067\u30C1\u30E3\u30FC\u30B8\u3067\u304D\u307E\u3059\u3002\u30C1\u30E3\u30FC\u30B8\u6642\u9593\u306B\u6BD4\u4F8B\u3057\u3066\u30C0\u30E1\u30FC\u30B8\u304C120%\u301C160%\u307E\u3067\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u518D\u4F7F\u7528\u5F85\u6A5F\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u5224\u5B9A\u7BC4\u56F2\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  - skillId: GunnerUltimate
    skillName: "\u7D68\u6BEF\u7206\u6483"
    skillDescription: "\u30AB\u30FC\u30BD\u30EB\u5730\u70B9\u3092\u4E2D\u5FC3\u306B\u534A\u5F848\u306E\u7BC4\u56F2\u5168\u4F53\u30920.5\u79D2\u9593\u9694\u30673\u56DE\u7206\u6483\u3057\u3001\u305D\u306E\u305F\u3073\u306B120%\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution1Description: "\u4FDD\u6709\u3057\u3066\u3044\u308B\u30B9\u30BF\u30C3\u30AF\u3092\u3059\u3079\u3066\u6D88\u8CBB\u3057\u3001\u9577\u3044\u76F4\u7DDA\uFF08\u9577\u30558\u3001\u5E451\uFF09\u7BC4\u56F2\u306B\u5373\u5EA7\u306B\u547D\u4E2D\u3055\u305B\u307E\u3059\u3002\u6D88\u8CBB\u3057\u305F\u30B9\u30BF\u30C3\u30AF1\u500B\u306B\u3064\u304D\u30C0\u30E1\u30FC\u30B8\u304C50%\u305A\u3064\u5897\u52A0\u3057\uFF08\u6700\u59273\u30B9\u30BF\u30C3\u30AF\u5206\u307E\u3067\u9069\u7528\uFF09\u3001\u7206\u767A\u7BC4\u56F2\u30C0\u30E1\u30FC\u30B8\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    evolution2Description: "\u30B9\u30BF\u30C3\u30AF1\u500B\u3067\u5F31\u4F53\u5316\u3057\u305F\u6295\u5C04\u7269\uFF08\u30C0\u30E1\u30FC\u30B850%\uFF09\u30920.1\u79D2\u9593\u9694\u30673\u767A\u9023\u7D9A\u767A\u5C04\u3057\u307E\u3059\u3002\u7206\u767A\u305B\u305A\u3001\u547D\u4E2D\u3057\u305F\u5BFE\u8C611\u4F53\u306B\u306E\u307F\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002"
    evolution3Description: "\u30B9\u30BF\u30C3\u30AF\u30922\u500B\u6D88\u8CBB\u3057\u3001\u7206\u767A\u534A\u5F84\u304C3\uFF08\u57FA\u672C\u306E3\u500D\uFF09\u307E\u3067\u5927\u5E45\u306B\u5E83\u304C\u3063\u305F\u62E1\u5F35\u7206\u767A\u5F3E\u3092\u767A\u5C04\u3057\u307E\u3059\u3002\u30C0\u30E1\u30FC\u30B8\u500D\u7387\u3082250%\u307E\u3067\u5927\u5E45\u306B\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement1Description: "\u30C0\u30E1\u30FC\u30B8\u304C55%\u5897\u52A0\u3057\u307E\u3059\u3002"
    enhancement2Description: "\u30B9\u30BF\u30C3\u30AF\u30C1\u30E3\u30FC\u30B8\u6642\u9593\u304C35%\u6E1B\u5C11\u3057\u307E\u3059\u3002"
    enhancement3Description: "\u6295\u5C04\u7269\u306E\u5C04\u7A0B\u304C30%\u5897\u52A0\u3057\u307E\u3059\u3002"
  chnLabels:
  - skillId: FighterHalfCircleSlash
    skillName: "\u534A\u5706\u65A9"
    skillDescription: "\u5BF9\u524D\u65B9\u534A\u5706\u8303\u56F4\uFF08\u5C04\u7A0B4\uFF0C\u89D2\u5EA6180\u5EA6\uFF09\u5185\u7684\u654C\u4EBA\u9020\u6210150%\u4F24\u5BB3\u3002"
    evolution1Description: "\u653B\u51FB\u5224\u5B9A\u989D\u5916\u9644\u52A0\u51FB\u9000\uFF08\u8DDD\u79BB5\uFF0C0.3\u79D2\uFF09\u548C\u7729\u6655\uFF083\u79D2\uFF09\u6548\u679C\u3002"
    evolution2Description: "\u6E05\u9664\u653B\u51FB\u8303\u56F4\u5185\u7684\u6240\u6709\u654C\u65B9\u5F39\u5E55\u3002"
    evolution3Description: "\u5224\u5B9A\u8303\u56F4\u4ECE\u524D\u65B9\u534A\u5706\u53D8\u4E3A360\u5EA6\u5706\u5F62\uFF0C\u53EF\u957F\u6309\u6700\u591A\u84C4\u529B3\u79D2\u3002\u4F24\u5BB3\u6839\u636E\u84C4\u529B\u65F6\u95F4\u4ECE120%\u589E\u81F3160%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u5224\u5B9A\u8303\u56F4\u6269\u592730%\u3002"
  - skillId: FighterLineSlam
    skillName: "\u76F4\u7EBF\u731B\u51FB"
    skillDescription: "\u5BF9\u524D\u65B9\u76F4\u7EBF\u8303\u56F4\uFF08\u957F\u5EA64\uFF0C\u5BBD\u5EA62\uFF09\u5185\u7684\u654C\u4EBA\u9020\u6210200%\u4F24\u5BB3\u3002"
    evolution1Description: "\u653B\u51FB\u5224\u5B9A\u989D\u5916\u9644\u52A0\u9632\u5FA1\u529B\u964D\u4F4E\uFF0830%\uFF0C4\u79D2\uFF09\u548C\u7729\u6655\uFF083\u79D2\uFF09\u6548\u679C\u3002"
    evolution2Description: "\u5224\u5B9A\u8303\u56F4\u6269\u5927\u4E3A\u957F\u5EA66\u3001\u5BBD\u5EA63\uFF0C\u547D\u4E2D\u7684\u654C\u4EBA\u4F1A\u88AB\u6D6E\u7A7A\uFF081.5\u79D2\uFF09\u3002"
    evolution3Description: "\u5224\u5B9A\u8303\u56F4\u7F29\u5C0F\u4E3A\u957F\u5EA62\u3001\u5BBD\u5EA61\uFF0C\u4F46\u4F24\u5BB3\u5927\u5E45\u63D0\u5347\u81F3350%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u5224\u5B9A\u8303\u56F4\u6269\u592730%\u3002"
  - skillId: FighterCursorDash
    skillName: "\u5149\u6807\u51B2\u523A"
    skillDescription: "\u671D\u5149\u6807\u65B9\u5411\u77ED\u8DDD\u79BB\u51B2\u523A\uFF08\u8DDD\u79BB4\uFF09\u3002\u65E0\u4F24\u5BB3\u3002"
    evolution1Description: "\u51B2\u523A\u5F00\u59CB\u7684\u540C\u65F6\u83B7\u5F970.5\u79D2\u65E0\u654C\u72B6\u6001\u3002"
    evolution2Description: "\u6539\u4E3A\u4F7F\u7528\u6700\u591A2\u5C42\u5C42\u6570\u7BA1\u7406\uFF0C\u4E0D\u518D\u6709\u51B7\u5374\u65F6\u95F4\uFF08\u6BCF\u5C424\u79D2\u5145\u80FD\uFF09\u3002"
    evolution3Description: "\u51B2\u523A\u7ED3\u675F\u540E\u7ACB\u5373\u83B7\u5F97\u6301\u7EED4\u79D2\u3001\u653B\u51FB\u529B\u63D0\u9AD820%\u7684\u589E\u76CA\u6548\u679C\u3002"
    enhancement1Description: "\u51B2\u523A\u79FB\u52A8\u65F6\u95F4\u51CF\u5C1155%\uFF0C\u79FB\u52A8\u901F\u5EA6\u66F4\u5FEB\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u51B2\u523A\u79FB\u52A8\u8DDD\u79BB\u589E\u52A030%\u3002"
  - skillId: GunnerArcBuster
    skillName: "\u7535\u5F27\u7206\u7834\u8005"
    skillDescription: "\u5411\u6B63\u9762\u53D1\u5C04\u5F39\u5E55\uFF0C\u547D\u4E2D\u654C\u4EBA\u65F6\u5BF9\u534A\u5F841\u8303\u56F4\u9020\u6210120%\u4F24\u5BB3\u3002\u6539\u4E3A\u4F7F\u7528\u6700\u591A6\u5C42\u5C42\u6570\u7BA1\u7406\uFF0C\u4E0D\u518D\u6709\u51B7\u5374\u65F6\u95F4\uFF08\u6BCF\u5C424\u79D2\u5145\u80FD\uFF09\uFF0C\u8FDE\u7EED\u53D1\u5C04\u95F4\u9694\u9650\u5236\u4E3A1\u79D2\u3002"
    evolution1Description: "\u6D88\u8017\u5168\u90E8\u5C42\u6570\uFF0C\u7ACB\u5373\u547D\u4E2D\u4E00\u6761\u957F\u76F4\u7EBF\uFF08\u957F\u5EA612\u3001\u5BBD\u5EA62\uFF09\u8303\u56F4\u3002\u6BCF\u6D88\u80171\u5C42\u4F24\u5BB3\u63D0\u534750%\uFF08\u6700\u591A\u8BA1\u7B976\u5C42\uFF09\uFF0C\u6CA1\u6709\u7206\u70B8\u8303\u56F4\u4F24\u5BB3\u3002"
    evolution2Description: "\u6D88\u80171\u5C42\u53D1\u5C043\u53D1\u5A01\u529B\u51CF\u5F31\u7684\u5F39\u5E55\uFF08\u4F24\u5BB350%\uFF09\uFF0C\u95F4\u96940.1\u79D2\u8FDE\u7EED\u53D1\u5C04\u3002\u4E0D\u4F1A\u7206\u70B8\uFF0C\u53EA\u5BF9\u547D\u4E2D\u7684\u5355\u4E2A\u76EE\u6807\u9020\u6210\u4F24\u5BB3\u3002"
    evolution3Description: "\u6D88\u80172\u5C42\u53D1\u5C04\u7206\u70B8\u8303\u56F4\u5927\u5E45\u6269\u5927\u81F33\uFF08\u57FA\u7840\u76843\u500D\uFF09\u7684\u6269\u5C55\u7206\u70B8\u5F39\u3002\u4F24\u5BB3\u500D\u7387\u4E5F\u5927\u5E45\u63D0\u5347\u81F3250%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u5C42\u6570\u5145\u80FD\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u5F39\u5E55\u5C04\u7A0B\u589E\u52A030%\u3002"
  - skillId: GunnerBombThrow
    skillName: "\u6295\u63B7\u70B8\u5F39"
    skillDescription: "\u671D\u5149\u6807\u4F4D\u7F6E\uFF08\u6700\u5927\u5C04\u7A0B6\uFF09\u4EE5\u629B\u7269\u7EBF\u6295\u63B7\u70B8\u5F39\u3002\u63A5\u89E6\u654C\u4EBA\u6216\u843D\u5730\u540E2\u79D2\uFF0C\u5BF9\u534A\u5F843\u8303\u56F4\u9020\u6210150%\u4F24\u5BB3\u3002"
    evolution1Description: "\u9996\u6B21\u7206\u70B80.5\u79D2\u540E\uFF0C\u5728\u534A\u5F844\u8303\u56F4\u5185\u518D\u53D1\u751F\u4E00\u6B21\u4E8C\u6B21\u7206\u70B8\uFF08\u4F24\u5BB3\u4E3A\u9996\u6B21\u7206\u70B8\u768450%\uFF09\u3002"
    evolution2Description: "\u7206\u70B8\u8303\u56F4\u6269\u5927\u81F34\uFF0C\u547D\u4E2D\u7684\u654C\u4EBA\u4F1A\u88AB\u7729\u6655\uFF081\u79D2\uFF09\u3002\u7206\u70B8\u70B9\u4F1A\u4EA7\u751F\u6301\u7EED5\u79D2\u7684\u51CF\u901F\u533A\u57DF\uFF0C\u4F7F\u533A\u57DF\u5185\u654C\u4EBA\u7684\u79FB\u52A8\u901F\u5EA6\u964D\u4F4E40%\u3002"
    evolution3Description: "\u5BF9\u7206\u70B8\u8303\u56F4\u5185\u7684\u654C\u4EBA\u65BD\u52A0\u6301\u7EED7\u79D2\u7684\u6807\u8BB0\u3002\u88AB\u6807\u8BB0\u7684\u654C\u4EBA\u53D7\u5230\u7684\u6240\u6709\u4F24\u5BB3\u63D0\u9AD825%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u6295\u63B7\u5C04\u7A0B\u589E\u52A030%\u3002"
  - skillId: GunnerBackstepShot
    skillName: "\u540E\u8DF3\u5C04\u51FB"
    skillDescription: "\u5BF9\u524D\u65B9\u6247\u5F62\u8303\u56F4\uFF08\u5C04\u7A0B5\uFF0C\u89D2\u5EA690\u5EA6\uFF09\u5185\u7684\u654C\u4EBA\u9020\u6210100%\u4F24\u5BB3\uFF0C\u968F\u540E\u671D\u5149\u6807\u53CD\u65B9\u5411\uFF08\u540E\u65B9\uFF09\u77ED\u8DDD\u79BB\u540E\u9000\uFF08\u8DDD\u79BB2\uFF09\u3002"
    evolution1Description: "\u4E0D\u518D\u8FDB\u884C\u6247\u5F62\u653B\u51FB\uFF0C\u800C\u662F\u5728\u539F\u4F4D\u7F6E\u653E\u7F6E\u8BF1\u9975\u3002\u8BF1\u9975\u4F1A\u57283\u79D2\u540E\u81EA\u52A8\u7206\u70B8\uFF0C\u5BF9\u534A\u5F843\u8303\u56F4\u9020\u6210100%\u4F24\u5BB3\u3002"
    evolution2Description: "\u540E\u9000\u79FB\u52A8\u7684\u540C\u65F6\u83B7\u5F970.3\u79D2\u65E0\u654C\u72B6\u6001\u3002"
    evolution3Description: "\u6247\u5F62\u653B\u51FB\u547D\u4E2D\u7684\u654C\u4EBA\u4F1A\u88AB\u51FB\u9000\uFF08\u8DDD\u79BB3\uFF0C0.3\u79D2\uFF09\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u653B\u51FB\u5C04\u7A0B\u548C\u540E\u9000\u79FB\u52A8\u8DDD\u79BB\u589E\u52A030%\u3002"
  - skillId: FighterUltimate
    skillName: "\u89C9\u9192"
    skillDescription: "\u5BF9\u81EA\u8EAB\u5468\u56F4\u534A\u5F843\u8303\u56F4\u5185\u7684\u654C\u4EBA\u9020\u6210100%\u4F24\u5BB3\uFF0C\u5E76\u572815\u79D2\u5185\u63D0\u5347\u653B\u51FB\u529B30%\u3001\u653B\u51FB\u901F\u5EA625%\u3001\u79FB\u52A8\u901F\u5EA615%\u3001\u9632\u5FA130%\u3002"
    evolution1Description: "\u653B\u51FB\u5224\u5B9A\u989D\u5916\u9644\u52A0\u51FB\u9000\uFF08\u8DDD\u79BB5\uFF0C0.3\u79D2\uFF09\u548C\u7729\u6655\uFF083\u79D2\uFF09\u6548\u679C\u3002"
    evolution2Description: "\u6E05\u9664\u653B\u51FB\u8303\u56F4\u5185\u7684\u6240\u6709\u654C\u65B9\u5F39\u5E55\u3002"
    evolution3Description: "\u5224\u5B9A\u8303\u56F4\u4ECE\u524D\u65B9\u534A\u5706\u53D8\u4E3A360\u5EA6\u5706\u5F62\uFF0C\u53EF\u957F\u6309\u6700\u591A\u84C4\u529B3\u79D2\u3002\u4F24\u5BB3\u6839\u636E\u84C4\u529B\u65F6\u95F4\u4ECE120%\u589E\u81F3160%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u51B7\u5374\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u5224\u5B9A\u8303\u56F4\u6269\u592730%\u3002"
  - skillId: GunnerUltimate
    skillName: "\u5730\u6BEF\u5F0F\u8F70\u70B8"
    skillDescription: "\u4EE5\u5149\u6807\u4F4D\u7F6E\u4E3A\u4E2D\u5FC3\uFF0C\u5BF9\u534A\u5F848\u7684\u6574\u4E2A\u533A\u57DF\u4EE50.5\u79D2\u95F4\u9694\u8F70\u70B83\u6B21\uFF0C\u6BCF\u6B21\u9020\u6210120%\u4F24\u5BB3\u3002"
    evolution1Description: "\u6D88\u8017\u5168\u90E8\u6301\u6709\u5C42\u6570\uFF0C\u7ACB\u5373\u547D\u4E2D\u4E00\u6761\u957F\u76F4\u7EBF\u8303\u56F4\uFF08\u957F\u5EA68\uFF0C\u5BBD\u5EA61\uFF09\u3002\u6BCF\u6D88\u80171\u5C42\u4F24\u5BB3\u63D0\u9AD850%\uFF08\u6700\u591A\u8BA1\u7B973\u5C42\uFF09\uFF0C\u65E0\u7206\u70B8\u8303\u56F4\u4F24\u5BB3\u3002"
    evolution2Description: "\u6D88\u80171\u5C42\u53D1\u5C043\u53D1\u5A01\u529B\u51CF\u5F31\u7684\u5F39\u5E55\uFF08\u4F24\u5BB350%\uFF09\uFF0C\u95F4\u96940.1\u79D2\u8FDE\u7EED\u53D1\u5C04\u3002\u4E0D\u4F1A\u7206\u70B8\uFF0C\u53EA\u5BF9\u547D\u4E2D\u7684\u5355\u4E2A\u76EE\u6807\u9020\u6210\u4F24\u5BB3\u3002"
    evolution3Description: "\u6D88\u80172\u5C42\u53D1\u5C04\u7206\u70B8\u8303\u56F4\u5927\u5E45\u6269\u5927\u81F33\uFF08\u57FA\u7840\u76843\u500D\uFF09\u7684\u6269\u5C55\u7206\u70B8\u5F39\u3002\u4F24\u5BB3\u500D\u7387\u4E5F\u5927\u5E45\u63D0\u5347\u81F3250%\u3002"
    enhancement1Description: "\u4F24\u5BB3\u63D0\u9AD855%\u3002"
    enhancement2Description: "\u5C42\u6570\u5145\u80FD\u65F6\u95F4\u51CF\u5C1135%\u3002"
    enhancement3Description: "\u5F39\u5E55\u5C04\u7A0B\u589E\u52A030%\u3002"
