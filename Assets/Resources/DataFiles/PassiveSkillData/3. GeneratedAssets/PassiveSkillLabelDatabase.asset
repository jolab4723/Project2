  - passiveId: AllSpeed
    name: "\uBAA8\uB4E0 \uC18D\uB3C4 \uC99D\uAC00"
    description: "\uC774\uB3D9 \uC18D\uB3C4\uC640 \uACF5\uACA9 \uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - passiveId: CritRate
    name: "\uD06C\uB9AC\uD2F0\uCEEC \uD655\uB960 \uC99D\uAC00"
    description: "\uCE58\uBA85\uD0C0 \uD655\uB960\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - passiveId: CritDamage
    name: "\uD06C\uB9AC\uD2F0\uCEEC \uD53C\uD574 \uC99D\uAC00"
    description: "\uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - passiveId: CooldownReduction
    name: "\uC2A4\uD0AC \uCFE8\uD0C0\uC784 \uAC10\uC18C"
    description: "\uBAA8\uB4E0 \uC2A4\uD0AC\uC758 \uCFE8\uD0C0\uC784\uC774 \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - passiveId: AllElementalBonus
    name: "\uBAA8\uB4E0 \uC18D\uC131 \uBCF4\uB108\uC2A4 \uC99D\uAC00"
    description: "\uD654\uC5FC\xB7\uB0C9\uAE30\xB7\uC804\uAE30 \uC18D\uC131 \uD53C\uD574
      \uBCF4\uB108\uC2A4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - passiveId: Revive
    name: "\uBD80\uD65C 1\uD68C \uD65C\uC131\uD654"
    description: "\uC804\uD22C \uC911 \uC4F0\uB7EC\uC84C\uC744 \uB54C \uCD5C\uB300
      \uCCB4\uB825\uC758 \uC77C\uBD80%\uC73C\uB85C 1\uD68C \uBD80\uD65C\uD55C\uB2E4."
  - passiveId: CampHealBonus
    name: "\uCEA0\uD504 \uD68C\uBCF5\uB7C9 \uC99D\uAC00"
    description: "\uCEA0\uD504\uC5D0\uC11C \uD734\uC2DD\uD560 \uB54C \uD68C\uBCF5\uD558\uB294
      \uCCB4\uB825\uB7C9\uC744 \uB298\uB9B0\uB2E4."
  - passiveId: ShopEnhance
    name: "\uC0C1\uC810 \uAC15\uD654"
    description: "\uB9AC\uB864 \uD69F\uC218\uAC00 1\uD68C \uCD94\uAC00\uB41C\uB2E4.
      \uB610\uD55C, \uC0C1\uC810 \uAC00\uACA9\uC774 \uD558\uB77D\uD55C\uB2E4."
  - passiveId: Undecided
    name: "\uBBF8\uC815"
    description: "\uC544\uC9C1 \uD6A8\uACFC\uAC00 \uC815\uD574\uC9C0\uC9C0 \uC54A\uC740
      \uD328\uC2DC\uBE0C."
  engLabels:
  - passiveId: MaxHealth
    name: Max Health Up
    description: Increases maximum health.
  - passiveId: AttackPower
    name: Attack Power Up
    description: Increases base attack power.
  - passiveId: DefensePower
    name: Defense Power Up
    description: Increases base defense.
  - passiveId: AllSpeed
    name: All Speed Up
    description: Increases movement speed and attack speed.
  - passiveId: CritRate
    name: Crit Rate Up
    description: Increases critical hit chance.
  - passiveId: CritDamage
    name: Crit Damage Up
    description: Increases critical hit damage.
  - passiveId: CooldownReduction
    name: Cooldown Reduction
    description: Reduces the cooldown of all skills.
  - passiveId: AllElementalBonus
    name: All Elemental Bonus Up
    description: Increases fire, ice, and electric elemental damage bonuses.
  - passiveId: Revive
    name: Revive Once
    description: Revive once with a percentage of max health when downed in battle.
  - passiveId: CampHealBonus
    name: Camp Heal Bonus
    description: Increases the amount of health restored when resting at camp.
  - passiveId: ShopEnhance
    name: Shop Enhancement
    description: Adds one extra reroll. Also lowers shop prices.
  - passiveId: Undecided
    name: Undecided
    description: A passive whose effect has not been decided yet.
