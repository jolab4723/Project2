    choice2Name: "\u30DF\u30F3\u30C8\u30B3\u30FC\u30E9\u3092\u98F2\u3080\u3002"
    choice2Description: "\u6700\u5927HP\u306e<color=#DC3132>60%</color>\u5206\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u307e\u3059\u3002\n<color=#8A2BE2>\u6301\u7d9a</color>\uff1a\u79fb\u52d5\u901f\u5ea6\u304c<color=#32CD32>20%</color>\u5897\u52a0\u3057\u307e\u3059\u3002"
