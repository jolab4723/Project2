    stageDescription: "\u30A6\u30A3\u30EA\u30A2\u30E0\u793E\u88FD\u306E\u6709\u540D\u306A\u98F2\u6599\u81EA\u52D5\u8CA9\u58F2\u6A5F\u3067\u3059\u3002\n\u3082\u3061\u308D\u3093\u3001\u60AA\u3044\u610F\u5473\u3067\u6709\u540D\u3067\u3059\u3002\n\u98F2\u6599\u306B\u306F\u57FA\u6E96\u5024\u3092\u8D85\u3048\u305F\u6210\u5206\u3084\u3001\u6B63\u4F53\u4E0D\u660E\u306E\u6210\u5206\u304C\u8A70\u307E\u3063\u3066\u3044\u307E\u3059\u3002\n\u5E83\u544A\u306B\u306F\u300C\u98F2\u3093\u3067\u751F\u304D\u6B8B\u3063\u305F\u304A\u5BA2\u69D8\u304B\u30895\u70B9\u6E80\u70B9\u4E2D4.7\u70B9\u300D\u3068\u66F8\u304B\u308C\u3066\u3044\u307E\u3059\u3002"
