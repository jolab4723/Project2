    stageDescription: "\u8FD9\u662F\u5A01\u5EC9\u516C\u53F8\u751F\u4EA7\u7684\u8457\u540D\u996E\u6599\u81EA\u52A8\u552E\u8D27\u673A\u3002\n\u5F53\u7136\uFF0C\u51FA\u540D\u7684\u539F\u56E0\u4E0D\u592A\u5149\u5F69\u3002\n\u996E\u6599\u4E2D\u585E\u6EE1\u4E86\u8D85\u51FA\u6807\u51C6\u5242\u91CF\u6216\u6210\u5206\u4E0D\u660E\u7684\u4E1C\u897F\u3002\n\u5E7F\u544A\u724C\u5199\u7740\uFF1A\u201C\u559D\u5B8C\u8FD8\u80FD\u6D3B\u7740\u7684\u987E\u5BA2\u7ED9\u51FA\u4E864.7\u5206\uFF08\u6EE1\u52065\u5206\uFF09\u3002\u201D"
    choice1Name: "\u559D\u80FD\u91CF\u996E\u6599\u3002"
    choice1Description: "\u53d7\u5230\u76f8\u5f53\u4e8e\u6700\u5927\u751f\u547d\u503c<color=#DC3132>60%</color>\u7684\u4f24\u5bb3\u3002\n<color=#8A2BE2>\u6301\u7eed</color>\uff1a\u653b\u51fb\u901f\u5ea6\u63d0\u9ad8<color=#32CD32>20%</color>\u3002"
    choice2Name: "\u559D\u8584\u8377\u53EF\u4E50\u3002"
    choice2Description: "\u53d7\u5230\u76f8\u5f53\u4e8e\u6700\u5927\u751f\u547d\u503c<color=#DC3132>60%</color>\u7684\u4f24\u5bb3\u3002\n<color=#8A2BE2>\u6301\u7eed</color>\uff1a\u79fb\u52a8\u901f\u5ea6\u63d0\u9ad8<color=#32CD32>20%</color>\u3002"
    choice3Name: "\u559D\u7EA2\u8336\u3002"
