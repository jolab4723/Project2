    stageDescription: "\u66FE\u7ECF\uFF0C\u6709\u4E00\u4F4D\u540D\u53EB\u897F\u8499\u7684\u5546\u4EBA\u4E70\u4E0B\u4E86\u8FD9\u9897\u661F\u7403\u3002\n\u4ED6\u5411\u524D\u6765\u503E\u5012\u5783\u573E\u7684\u4EBA\u6536\u8D2D\u5E9F\u6599\uFF0C\u518D\u52A0\u5DE5\u540E\u51FA\u552E\u3002\n\u751F\u610F\u4E00\u76F4\u5F88\u987A\u5229\u3002\n\u76F4\u5230\u4E00\u7FA4\u50CF\u662F\u7531\u5E9F\u6599\u62FC\u6210\u7684\u964C\u751F\u673A\u5668\u4EBA\u95EF\u8FDB\u4ED6\u7684\u529E\u516C\u5BA4\u3002\n\u9057\u61BE\u7684\u662F\uFF0C\u90A3\u4E9B\u673A\u5668\u4EBA\u7684\u76EE\u6807\u4F3C\u4E4E\u5E76\u4E0D\u662F\u4FE1\u7528\u70B9\u3002"
