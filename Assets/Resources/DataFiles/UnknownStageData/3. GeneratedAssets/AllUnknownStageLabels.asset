  m_Script: {fileID: 11500000, guid: 086a3a153f65d9b46a57c47b8b1e43d6, type: 3}
  m_Name: AllUnknownStageLabels
  m_EditorClassIdentifier: Assembly-CSharp::YJ_UnknownStageLabelDatabaseSO
  korLabels:
  - stageId: stage.unknown.overcharge
    stageName: "\uACFC\uCDA9\uC804"
    stageDescription: "\uACF5\uC7A5 \uC548\uCABD\uC5D0\uC11C \uADDC\uACA9\uC774 \uB9DE\uC9C0
      \uC54A\uB294 \uB300\uD615 \uCDA9\uC804\uAE30\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n\uBCC0\uD658
      \uC820\uB354\uB294 \uCC3E\uC9C0 \uBABB\uD588\uC9C0\uB9CC \uC5B5\uC9C0\uB85C
      \uCDA9\uC804\uD558\uB824\uBA74 \uD560 \uC218 \uC788\uC744\uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uCDA9\uC804\uD55C\uB2E4."
    choice1Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9\ub825\uc774 <color=#32CD32>5%</color> \uc99d\uac00\ud569\ub2c8\ub2e4.\n\ucd5c\ub300 \uccb4\ub825\uc758 <color=#DC3132>30%</color>\ub9cc\ud07c \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4."
    choice2Name: "\uB5A0\uB09C\uB2E4."
    choice2Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.emergency_ration
    stageName: "\uC720\uD1B5\uAE30\uD55C: 3\uC138\uAE30 \uC804"
    stageDescription: "\uBE44\uC0C1\uC2DD\uB7C9 \uBCF4\uAD00\uD568\uC774 \uC5F4\uB824\uC788\uC2B5\uB2C8\uB2E4.\n\uC720\uD1B5\uAE30\uD55C\uC740
      \uD55C\uCC38 \uC9C0\uB0AC\uACE0, \uB3D9\uBB3C\uC0AC\uB8CC\uAC19\uC740 \uB0C4\uC0C8\uAC00
      \uB098\uC9C0\uB9CC, \uB0B4\uC6A9\uBB3C\uC740 \uBA40\uCA61\uD574 \uBCF4\uC785\uB2C8\uB2E4."
    choice1Name: "\uBA39\uB294\uB2E4."
    choice1Description: "\uccb4\ub825\uc744 \ucd5c\ub300 \uccb4\ub825\uc758 <color=#32CD32>30%</color>\ub9cc\ud07c \ud68c\ubcf5\ud569\ub2c8\ub2e4.\n<color=#8A2BE2>\uc77c\ud68c\uc131</color>: \ubc29\uc5b4\ub825\uc774 <color=#DC3132>30%</color> \uac10\uc18c\ud569\ub2c8\ub2e4."
    choice2Name: "\uC870\uC6A9\uD788 \uB2EB\uB294\uB2E4."
    choice2Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.maintenance_Drone
    stageName: "\uB178\uB798\uD558\uB294 \uC815\uBE44 \uB4DC\uB860"
    stageDescription: "\uACE0\uC7A5\uB09C \uC815\uBE44 \uB4DC\uB860\uC774 \uBC14\uB2E5\uC5D0
      \uB110\uBD80\uB7EC\uC9C4 \uCC44 \uBE44\uD504\uC74C\uC744 \uB0B4\uBA74\uC11C
      \uB204\uAD70\uAC00\uAC00 \uC218\uB9AC\uD574\uC8FC\uAE38 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\uBE44\uD504\uC74C\uC744 \uACC4\uC18D \uB4E3\uACE0\uC788\uC73C\uB2C8
      \uB178\uB798\uCC98\uB7FC \uB4E4\uB9AC\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
    choice1Name: "\uC218\uB9AC\uD55C\uB2E4."
    choice1Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \ubc29\uc5b4\ub825\uc774 <color=#32CD32>10%</color> \uc99d\uac00\ud569\ub2c8\ub2e4."
    choice2Name: "\uCF54\uC5B4\uB97C \uB72F\uC5B4\uB0B8\uB2E4."
    choice2Description: "<color=#32CD32>\uc815\ube44\ub4dc\ub860\uc758 \ucf54\uc5b4</color>\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.red_button
    stageName: "\uB204\uB974\uBA74 \uC548 \uB418\uB294 \uBC84\uD2BC"
    stageDescription: "\uBCF5\uB3C4 \uD55C\uAC00\uC6B4\uB370\uC5D0 \uBE68\uAC04 \uBC84\uD2BC\uC774
      \uD558\uB098 \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8 \uC544\uB798\uC5D0\uB294 \uCE5C\uC808\uD558\uAC8C\uB3C4
      '\uB204\uB974\uC9C0 \uB9C8\uC2DC\uC624'\uB77C\uACE0 \uC801\uD600 \uC788\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uB204\uB978\uB2E4."
    choice1Description: "<color=#DAA520>\uc5d8\ub9ac\ud2b8 \uc2a4\ud14c\uc774\uc9c0</color>\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4."
    choice2Name: "\uACBD\uACE0\uB97C \uC874\uC911\uD55C\uB2E4."
    choice2Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.unclaimed_locker
    stageName: "\uC8FC\uC778 \uC5C6\uB294 \uC0AC\uBB3C\uD568"
    stageDescription: "\uB0A1\uC740 \uC0AC\uBB3C\uD568\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n\uB204\uAD6C\uC758
      \uC0AC\uBB3C\uD568\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uC790\uBB3C\uC1E0\uB85C
      \uAD73\uAC8C \uC7A0\uACA8\uC788\uC2B5\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
      \uC790\uBB3C\uC1E0\uC758 \uBC88\uD638\uB97C \uB9DE\uCDB0\uBD05\uB2C8\uB2E4."
    choice1Name: "\uBE44\uBC00\uBC88\uD638\uB97C \uCD94\uCE21\uD55C\uB2E4."
    choice1Description: "50% \ud655\ub960\ub85c \uc720\uc77c \ub4f1\uae09\uc758 <color=#32CD32>\ubb34\uc791\uc704 \uc7a5\ube44 1\uac1c</color>\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4."
    choice2Name: "\uAC15\uC81C\uB85C \uC5F0\uB2E4."
    choice2Description: "\uace0\uae09 \ub4f1\uae09\uc758 <color=#32CD32>\ubb34\uc791\uc704 \uc7a5\ube44 2\uac1c</color>\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.magnetic_storm
    stageName: "\uC790\uAE30 \uD3ED\uD48D"
    stageDescription: "\uAC70\uB300\uD55C \uC790\uAE30 \uD3ED\uD48D\uB54C\uBB38\uC5D0
      \uAC74\uBB3C \uC804\uCCB4\uAC00 \uD754\uB4E4\uB9BD\uB2C8\uB2E4.\n\uC8FC\uBA38\uB2C8\uC18D\uC758
      \uAE08\uC18D \uBB3C\uCCB4\uB4E4\uC774 \uC694\uB3D9\uCE58\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uBB34\uC5C7\uC774\uB77C\uB3C4
      \uD3EC\uAE30\uD574\uC57C \uC774\uACF3\uC744 \uBC97\uC5B4\uB0A0 \uC218 \uC788\uC744\uAC81\uB2C8\uB2E4."
    choice1Name: "\uC544\uC774\uD15C\uC744 \uBC84\uB9B0\uB2E4."
    choice1Description: "\uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c <color=#DC3132>\uc544\uc774\ud15c 3\uac1c</color>\ub97c \uc120\ud0dd\ud558\uc5ec \ubc84\ub9bd\ub2c8\ub2e4."
    choice2Name: "\uB2EC\uB824\uC11C \uD0C8\uCD9C\uD55C\uB2E4."
    choice2Description: "\uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c <color=#DC3132>\ubb34\uc791\uc704 \uc544\uc774\ud15c 2\uac1c</color>\ub97c \ubc84\ub9bd\ub2c8\ub2e4."
    choice3Name: "\uBC14\uB2E5\uC5D0 \uC5CE\uB4DC\uB9B0\uB2E4."
    choice3Description: "<color=#DC3132>\ubaa8\ub4e0 \uace8\ub4dc</color>\ub97c \uc783\uc2b5\ub2c8\ub2e4."
  - stageId: stage.unknown.software_update
    stageName: "\uC18C\uD504\uD2B8\uC6E8\uC5B4 \uC5C5\uB370\uC774\uD2B8"
    stageDescription: "\uC815\uBE44 \uB2E8\uB9D0\uAE30\uAC00 \uCD5C\uC2E0 \uC18C\uD504\uD2B8\uC6E8\uC5B4\uB85C
      \uC5C5\uB370\uC774\uD2B8\uD560\uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4.\n\uB298
      \uADF8\uB807\uB4EF \uC0C8\uB85C\uC6B4 \uD504\uB85C\uADF8\uB7A8\uC740 \uBB38\uC81C\uAC00
      \uC788\uAE30 \uB9C8\uB828\uC785\uB2C8\uB2E4."
    choice1Name: "\uCD5C\uC2E0 \uBC84\uC804\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uD55C\uB2E4."
    choice1Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9\ub825\uc774 <color=#32CD32>8%</color> \uc99d\uac00\ud569\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \ubc29\uc5b4\ub825\uc774 <color=#DC3132>15%</color>: \uac10\uc18c\ud569\ub2c8\ub2e4."
    choice2Name: "\uC548\uC815 \uBC84\uC804\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uD55C\uB2E4."
    choice2Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \ubc29\uc5b4\ub825\uc774 <color=#32CD32>10%</color> \uc99d\uac00\ud569\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9\ub825\uc774 <color=#DC3132>5%</color> \uac10\uc18c\ud569\ub2c8\ub2e4."
    choice3Name: "\uB098\uC911\uC5D0 \uB2E4\uC2DC \uC54C\uB9BC."
    choice3Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - stageId: stage.unknown.vending_machine
    stageName: "\uC70C\uB9AC\uC5C4 \uC790\uD310\uAE30"
    stageDescription: "\uC70C\uB9AC\uC5C4\uC0AC\uC5D0\uC11C \uB9CC\uB4E0 \uC720\uBA85\uD55C
      \uC74C\uB8CC \uC790\uD310\uAE30\uC785\uB2C8\uB2E4.\n\uBB3C\uB860 \uB2E4\uB978
      \uBC29\uD5A5\uC73C\uB85C \uC720\uBA85\uD569\uB2C8\uB2E4.\n\uC74C\uB8CC\uC5D0\uB294
      \uAE30\uC900\uCE58 \uC6A9\uB7C9\uC744 \uCD08\uACFC\uD558\uAC70\uB098 \uC815\uCCB4\uB97C
      \uC54C \uC218 \uC5C6\uB294 \uC131\uBD84\uC774 \uAC00\uB4DD\uD569\uB2C8\uB2E4.\n\uAD11\uACE0\uD310\uC5D0\uB294
      \uC74C\uB8CC\uB97C \uB9C8\uC2DC\uACE0 \uC0B4\uC544\uB0A8\uC740 \uACE0\uAC1D\uB4E4\uC758
      \uD3C9\uAC00\uB294 5\uC810 \uB9CC\uC810\uC5D0 4.7\uC810\uC774\uB77C\uACE0 \uC801\uD600\uC788\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uC5D0\uB108\uC9C0 \uB4DC\uB9C1\uD06C\uB97C \uB9C8\uC2E0\uB2E4."
    choice1Description: "\ucd5c\ub300 \uccb4\ub825\uc758 <color=#DC3132>60%</color>\ub9cc\ud07c \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9 \uc18d\ub3c4\uac00 <color=#32CD32>20%</color> \uc99d\uac00\ud569\ub2c8\ub2e4."
    choice2Name: "\uBBFC\uD2B8\uB9DB \uCF5C\uB77C\uB97C \uB9C8\uC2E0\uB2E4."
    choice2Description: "\ucd5c\ub300 \uccb4\ub825\uc758 <color=#DC3132>60%</color>\ub9cc\ud07c \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \uc774\ub3d9\uc18d\ub3c4\uac00 <color=#32CD32>20%</color> \uc99d\uac00\ud569\ub2c8\ub2e4."
    choice3Name: "\uD64D\uCC28\uB97C \uB9C8\uC2E0\uB2E4."
    choice3Description: "\ucd5c\ub300 \uccb4\ub825\uc758 <color=#DC3132>60%</color>\ub9cc\ud07c \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: MP\ud68c\ubcf5\ub825\uc774 <color=#32CD32>20%</color> \uc99d\uac00\ud569\ub2c8\ub2e4."
  - stageId: stage.unknown.broken_safe
    stageName: "\uBD80\uC11C\uC9C4 \uAE08\uACE0"
    stageDescription: "\uACFC\uAC70 \uC774 \uD589\uC131\uC744 \uAD6C\uB9E4\uD55C
      \uC0AC\uC774\uBA3C\uC774\uB77C\uB294 \uC0AC\uC5C5\uAC00\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8\uB294
      \uC4F0\uB808\uAE30\uB97C \uBC84\uB9AC\uB7EC \uC624\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uACE0\uCCA0\uC744 \uC0AC\uB4E4\uC600\uACE0, \uADF8 \uACE0\uCCA0\uB4E4\uC744
      \uAC00\uACF5\uD558\uC5EC \uD310\uB9E4\uD558\uB294 \uC0AC\uC5C5\uC744 \uBC8C\uC600\uC2B5\uB2C8\uB2E4.\n\uC0AC\uC5C5\uC740
      \uC21C\uC870\uB86D\uAC8C \uC9C4\uD589\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uACE0\uCCA0\uB85C
      \uB9CC\uB4E4\uC5B4\uC9C4\uB4EF\uD55C \uCC98\uC74C\uBCF4\uB294 \uB85C\uBD07\uB4E4\uC774
      \uC0AC\uBB34\uC2E4\uB85C \uCCD0\uB4E4\uC5B4\uC624\uAE30 \uC804\uAE4C\uC9C0\uB294\uC694.\n\uC548\uD0C0\uAE5D\uAC8C\uB3C4
      \uB85C\uBD07\uB4E4\uC758 \uBAA9\uC801\uC740 \uD06C\uB808\uB527\uC774 \uC544\uB2C8\uC600\uB358\uAC83
      \uAC19\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uAE08\uACE0\uB97C \uC5F4\uC5B4\uBCF8\uB2E4."
    choice1Description: "<color=#32CD32>1000\ud06c\ub808\ub527</color>\uc744 \ud68d\ub4dd\ud569\ub2c8\ub2e4."
    choice2Name: 
    choice2Description: 
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.delivery_robot
    stageName: "\uAE38 \uC783\uC740 \uBC30\uC1A1 \uB85C\uBD07"
    stageDescription: "\uBC30\uC1A1 \uB85C\uBD07\uC774 \uC218\uCDE8\uC778\uC744 300\uB144\uC9F8
      \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC18C\uD3EC\uB97C \uBE8F\uC5B4 \uD655\uC778\uD574\uBCF4\uB2C8
      \uC0AC\uC774\uBA3C\uC774\uB77C\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uBC30\uB2EC\uB420
      \uBB3C\uAC74\uC774\uC600\uB358\uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\n\uB85C\uBD07\uC774
      \uC18C\uD3EC\uB97C \uB3CC\uB824\uB2EC\uB77C\uACE0 \uACBD\uACE0\uC74C\uC744
      \uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uC18C\uD3EC\uB97C \uC5F0\uB2E4."
    choice1Description: "<color=#32CD32>\ubc29\uc804\ub41c \ucf54\uc5b4</color>\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4.\n<color=#DAA520>\uc5d8\ub9ac\ud2b8 \uc2a4\ud14c\uc774\uc9c0</color>\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4."
    choice2Name: "\uC18C\uD3EC\uB97C \uB3CC\uB824\uC900\uB2E4."
    choice2Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.emergency_vent
    stageName: "\uBE44\uC0C1 \uD658\uD48D\uAD6C"
    stageDescription: "\uB2F9\uC2E0\uC740 \uCAD2\uC544\uC624\uB294 \uB85C\uBD07\uAD70\uB2E8\uC744
      \uD53C\uD574 \uD658\uD48D\uAD6C\uB85C \uC228\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD658\uD48D\uAD6C
      \uC548\uC740 \uBA3C\uC9C0\uB85C \uAC00\uB4DD\uD574\uC11C \uB418\uB3C4\uB85D\uC774\uBA74
      \uBE68\uB9AC \uB098\uAC00\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.\n\uC11C\uB450\uB974\uB358
      \uB2F9\uC2E0\uC740 \uB450 \uAC08\uB798\uAE38\uC744 \uB9C8\uC8FC\uD569\uB2C8\uB2E4."
    choice1Name: "\uC67C\uCABD\uC73C\uB85C \uAC04\uB2E4."
    choice1Description: "<color=#DAA520>\ucea0\ud504</color>\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4."
    choice2Name: "\uC624\uB978\uCABD\uC73C\uB85C \uAC04\uB2E4."
    choice2Description: "<color=#DAA520>\uc77c\ubc18 \uc2a4\ud14c\uc774\uc9c0</color>\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.ai_counseling
    stageName: "AI \uC0C1\uB2F4\uC2E4"
    stageDescription: "\uAD74\uC9C0\uC758 IT\uD68C\uC0AC\uC778 \uBC84\uB2DD\uB808\uBAAC\uD14C\uD06C\uC5D0\uC11C
      \uB9CC\uB4E0 AI \uC0C1\uB2F4\uAC00\uC785\uB2C8\uB2E4.\nAI \uC0C1\uB2F4\uAC00\uB294
      \uB180\uB78D\uAC8C\uB3C4 \uB2F9\uC2E0\uC758 \uACE0\uBBFC\uC744 0.003\uCD08
      \uB9CC\uC5D0 \uBD84\uC11D\uD558\uC5EC \uD574\uACB0\uCC45\uC744 \uB3C4\uCD9C\uD588\uC2B5\uB2C8\uB2E4!\n\uB2F9\uC2E0\uC740
      \uB2F5\uBCC0\uC744 \uD655\uC778\uD558\uB824\uD588\uACE0, 60\uCD08\uC9DC\uB9AC
      \uAD11\uACE0 \uC601\uC0C1\uC774 \uC7AC\uC0DD\uB429\uB2C8\uB2E4."
    choice1Name: "\uBBF8\uB798\uC5D0 \uB300\uD55C \uC0C1\uB2F4\uC744 \uD55C\uB2E4."
    choice1Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9\ub825\uc774 <color=#32CD32>5%</color> \uc99d\uac00\ud569\ub2c8\ub2e4.\n\ucd5c\ub300 \uccb4\ub825\uc774 <color=#DC3132>5%</color> \uac10\uc18c\ud569\ub2c8\ub2e4."
    choice2Name: "\uACFC\uAC70\uC5D0 \uB300\uD55C \uC0C1\uB2F4\uC744 \uD55C\uB2E4."
    choice2Description: "\ucd5c\ub300 \uccb4\ub825\uc774 <color=#32CD32>5%</color> \uc99d\uac00\ud569\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \uacf5\uaca9\ub825\uc774 <color=#DC3132>5%</color> \uac10\uc18c\ud569\ub2c8\ub2e4."
    choice3Name: "\uAD11\uACE0\uB97C \uAC74\uB108\uB6F4\uB2E4."
    choice3Description: "<color=#DC3132>200\ud06c\ub808\ub527</color>\uc744 \uc9c0\ubd88\ud569\ub2c8\ub2e4.\n<color=#8A2BE2>\uc9c0\uc18d</color>: \uc774\ub3d9\uc18d\ub3c4\uac00 <color=#32CD32>5%</color> \uc99d\uac00\ud569\ub2c8\ub2e4."
  - stageId: stage.unknown.scrap_compactor
    stageName: "\uACE0\uCCA0 \uC555\uCD95\uAE30"
    stageDescription: "\uC555\uCD95\uAE30\uAC00 \uAD49\uC74C\uC744 \uB0B4\uBA70 \uACE0\uCCA0\uB4E4\uC744
      \uC9D1\uC5B4\uC0BC\uD0B5\uB2C8\uB2E4.\n\uC0BC\uCF1C\uC9C4 \uACE0\uCCA0\uB4E4\uC740
      \uD050\uBE0C\uBAA8\uC591\uC73C\uB85C \uC555\uCD95\uB418\uC5B4 \uB4A4\uD3B8\uC5D0
      \uC313\uC774\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    choice1Name: "\uC544\uC774\uD15C\uC744 \uB123\uB294\uB2E4."
    choice1Description: "\uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c <color=#DC3132>\uc544\uc774\ud15c 2\uac1c</color>\ub97c \uc120\ud0dd\ud558\uc5ec \ubc84\ub9bd\ub2c8\ub2e4.\n<color=#32CD32>400\ud06c\ub808\ub527</color>\uc744 \ud68d\ub4dd\ud569\ub2c8\ub2e4.\n<color=#32CD32>\uace0\ucca0 \ud050\ube0c \ucf54\uc5b4</color>\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4."
    choice2Name: "\uB5A0\uB09C\uB2E4."
    choice2Description: "\uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.memory_data
    stageName: "\uB0AF\uC120 \uAE30\uC5B5 \uB370\uC774\uD130"
    stageDescription: "\uB2F9\uC2E0\uC758 \uAC83\uC774 \uC544\uB2CC \uC2A4\uCE90\uBE48\uC800\uC758
      \uAE30\uC5B5 \uB370\uC774\uD130\uAC00 \uBC14\uB2E5\uC5D0\uC11C \uAE5C\uBE61\uC774\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n\uACFC\uAC70 \uC774\uACF3\uC744 \uD0D0\uD5D8\uD588\uB358
      \uC2A4\uCE90\uBE48\uC800\uAC00 \uC548\uD0C0\uAE4C\uC6B4 \uCD5C\uD6C4\uB97C
      \uB9DE\uC774\uD55C \uAC83\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4.\n\uB370\uC774\uD130\uC758
      \uB0B4\uC6A9\uC744 \uD655\uC778\uD574\uBCF4\uB2C8 \uC804\uD22C \uAE30\uC220
      80%, \uACE0\uC591\uC774 \uC601\uC0C1 20%\uC785\uB2C8\uB2E4."
    choice1Name: "\uC804\uD22C \uB370\uC774\uD130\uB97C \uC124\uCE58\uD55C\uB2E4."
    choice1Description: "<color=#8A2BE2>\uc9c0\uc18d</color>: \uc2a4\ud0ac \uc7ac\uc0ac\uc6a9 \ub300\uae30\uc2dc\uac04\uc774 5% \uac10\uc18c\ud569\ub2c8\ub2e4.\n\ucd5c\ub300 \uccb4\ub825\uc758 <color=#DC3132>5%</color>\ub9cc\ud07c \ud53c\ud574\ub97c \ubc1b\uc2b5\ub2c8\ub2e4."
    choice2Name: "\uACE0\uC591\uC774 \uC601\uC0C1\uB9CC \uBCF8\uB2E4."
    choice2Description: "\uccb4\ub825\uc744 \ucd5c\ub300 \uccb4\ub825\uc758 <color=#32CD32>20%</color>\ub9cc\ud07c \ud68c\ubcf5\ud569\ub2c8\ub2e4."
    choice3Name: 
    choice3Description: 
  engLabels:
  - stageId: stage.unknown.overcharge
    stageName: Overcharge
    stageDescription: 'Deep inside the factory, you find a large charger that does
      not match your specifications.

      You could not find an adapter, but it
      looks like you could force a charge if you really wanted to.'
    choice1Name: Plug in.
    choice1Description: "<color=#8A2BE2>Persistent</color>: Attack increases by <color=#32CD32>5%</color>.\nTake damage equal to <color=#DC3132>30%</color> of maximum HP."
    choice2Name: Leave.
    choice2Description: No effect.
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.emergency_ration
    stageName: 'Best Before: Three Centuries Ago'
    stageDescription: 'An emergency ration locker stands open.

      The expiration
      date is long past and it smells like animal feed, but the contents appear perfectly
      fine.'
    choice1Name: Eat it.
    choice1Description: "Restore <color=#32CD32>30%</color> of maximum HP.\n<color=#8A2BE2>Next battle only</color>: Defense decreases by <color=#DC3132>30%</color>."
    choice2Name: Close it quietly.
    choice2Description: No effect.
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.maintenance_Drone
    stageName: The Singing Maintenance Drone
    stageDescription: 'A broken maintenance drone lies on the floor, beeping as it
      waits for someone to repair it.

      After listening for a while, the beeps
      almost begin to sound like a song.'
    choice1Name: Repair it.
    choice1Description: "<color=#8A2BE2>Persistent</color>: Defense increases by <color=#32CD32>10%</color>."
    choice2Name: Rip out the core.
    choice2Description: "Obtain the <color=#32CD32>Maintenance Drone Core</color>."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.red_button
    stageName: The Button You Should Not Press
    stageDescription: 'A red button sits in the middle of the corridor.

      A
      helpful label beneath it reads, ''DO NOT PRESS.'''
    choice1Name: Press it.
    choice1Description: "Move to an <color=#DAA520>Elite Stage</color>."
    choice2Name: Respect the warning.
    choice2Description: No effect.
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.unclaimed_locker
    stageName: The Unclaimed Locker
    stageDescription: 'You find an old locker.

      You do not know who owns it,
      but it is secured with a sturdy padlock.

      You cautiously try to guess
      the combination.'
    choice1Name: Guess the combination.
    choice1Description: "50% chance to obtain <color=#32CD32>1 random Unique-grade piece of equipment</color>."
    choice2Name: Force it open.
    choice2Description: "Obtain <color=#32CD32>2 random Advanced-grade pieces of equipment</color>."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.magnetic_storm
    stageName: Magnetic Storm
    stageDescription: 'A massive magnetic storm shakes the entire building.

      The
      metal objects in your pockets begin thrashing around.

      You will have
      to give something up to escape.'
    choice1Name: Discard some items.
    choice1Description: "Select and discard <color=#DC3132>3 items</color> from your inventory."
    choice2Name: Run for the exit.
    choice2Description: "Discard <color=#DC3132>2 random items</color> from your inventory."
    choice3Name: Drop to the floor.
    choice3Description: "Lose <color=#DC3132>all Credits</color>."
  - stageId: stage.unknown.software_update
    stageName: Software Update
    stageDescription: 'A maintenance terminal recommends updating to the latest software.

      As
      always, new software tends to arrive with new problems.'
    choice1Name: Update to the latest version.
    choice1Description: "<color=#8A2BE2>Persistent</color>: Attack increases by <color=#32CD32>8%</color>.\n<color=#8A2BE2>Persistent</color>: Defense decreases by <color=#DC3132>15%</color>."
    choice2Name: Install the stable version.
    choice2Description: "<color=#8A2BE2>Persistent</color>: Defense increases by <color=#32CD32>10%</color>.\n<color=#8A2BE2>Persistent</color>: Attack decreases by <color=#DC3132>5%</color>."
    choice3Name: Remind me later.
    choice3Description: No effect.
  - stageId: stage.unknown.vending_machine
    stageName: William Vending Machine
    stageDescription: 'This is a famous beverage vending machine made by William
      Corporation.

      Famous for all the wrong reasons, of course.

      Its
      drinks are packed with ingredients that exceed recommended limits or cannot
      be identified at all.

      The advertisement proudly gives the drinks a 4.7
      out of 5 rating from customers who survived them.'
    choice1Name: Drink the energy drink.
    choice1Description: "Take damage equal to <color=#DC3132>60%</color> of maximum HP.\n<color=#8A2BE2>Persistent</color>: Attack speed increases by <color=#32CD32>20%</color>."
    choice2Name: Drink the mint cola.
    choice2Description: "Take damage equal to <color=#DC3132>60%</color> of maximum HP.\n<color=#8A2BE2>Persistent</color>: Movement speed increases by <color=#32CD32>20%</color>."
    choice3Name: Drink the black tea.
    choice3Description: "Take damage equal to <color=#DC3132>60%</color> of maximum HP.\n<color=#8A2BE2>Persistent</color>: MP recovery increases by <color=#32CD32>20%</color>."
  - stageId: stage.unknown.broken_safe
    stageName: Broken Safe
    stageDescription: 'There was once a businessman named Simon who purchased this
      planet.

      He bought scrap from people who came to dump their waste, processed
      it, and sold it for profit.

      Business proceeded smoothly.

      At least,
      until unfamiliar robots seemingly made of scrap stormed his office.

      Unfortunately,
      Credits do not appear to have been what the robots wanted.'
    choice1Name: Open the safe.
    choice1Description: "Gain <color=#32CD32>1,000 Credits</color>."
    choice2Name: 
    choice2Description: 
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.delivery_robot
    stageName: The Lost Delivery Robot
    stageDescription: 'A delivery robot has been searching for its recipient for
      300 years.

      After taking the package and examining it, you discover that
      it was meant for someone named Simon.

      The robot emits a warning tone,
      demanding the package back.'
    choice1Name: Open the package.
    choice1Description: "Obtain a <color=#32CD32>Depleted Core</color>.\nMove to an <color=#DAA520>Elite Stage</color>."
    choice2Name: Return the package.
    choice2Description: No effect.
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.emergency_vent
    stageName: Emergency Vent
    stageDescription: 'You hide inside a ventilation duct to escape the pursuing
      robot army.

      The duct is filled with dust, and you would rather leave
      as soon as possible.

      As you hurry forward, the passage splits in two.'
    choice1Name: Go left.
    choice1Description: "Move to <color=#DAA520>Camp</color>."
    choice2Name: Go right.
    choice2Description: "Move to a <color=#DAA520>Normal Stage</color>."
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.ai_counseling
    stageName: AI Counseling Room
    stageDescription: 'This AI counselor was created by the leading IT company Burning
      Lemon Tech.

      Remarkably, it analyzes your concerns and produces a solution
      in just 0.003 seconds!

      As you try to view the answer, a 60-second advertisement
      begins playing.'
    choice1Name: Ask about the future.
    choice1Description: "<color=#8A2BE2>Persistent</color>: Attack increases by <color=#32CD32>5%</color>.\nMaximum HP decreases by <color=#DC3132>5%</color>."
    choice2Name: Ask about the past.
    choice2Description: "Maximum HP increases by <color=#32CD32>5%</color>.\n<color=#8A2BE2>Persistent</color>: Attack decreases by <color=#DC3132>5%</color>."
    choice3Name: Skip the advertisement.
    choice3Description: "Pay <color=#DC3132>200 Credits</color>.\n<color=#8A2BE2>Persistent</color>: Movement speed increases by <color=#32CD32>5%</color>."
  - stageId: stage.unknown.scrap_compactor
    stageName: Scrap Compactor
    stageDescription: 'The compactor roars as it devours piles of scrap.

      The
      swallowed metal is compressed into cubes and stacked behind the machine.'
    choice1Name: Put in some items.
    choice1Description: "Select and discard <color=#DC3132>2 items</color> from your inventory.\nGain <color=#32CD32>400 Credits</color>.\nObtain the <color=#32CD32>Scrap Cube Core</color>."
    choice2Name: Leave.
    choice2Description: No effect.
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.memory_data
    stageName: Unfamiliar Memory Data
    stageDescription: 'Memory data belonging to an unknown scavenger flickers on
      the floor.

      It appears that the scavenger who explored this place before
      you met an unfortunate end.

      The data contains 80% combat techniques
      and 20% cat videos.'
    choice1Name: Install the combat data.
    choice1Description: "<color=#8A2BE2>Persistent</color>: Skill cooldown decreases by 5%.\nTake damage equal to <color=#DC3132>5%</color> of maximum HP."
    choice2Name: Watch only the cat videos.
    choice2Description: "Restore <color=#32CD32>20%</color> of maximum HP."
    choice3Name: 
    choice3Description: 
  jpnLabels:
  - stageId: stage.unknown.overcharge
    stageName: "\u904E\u5145\u96FB"
    stageDescription: "\u5DE5\u5834\u306E\u5965\u3067\u3001\u898F\u683C\u306E\u5408\u308F\u306A\u3044\u5927\u578B\u5145\u96FB\u5668\u3092\u767A\u898B\u3057\u307E\u3057\u305F\u3002\n\u5909\u63DB\u30A2\u30C0\u30D7\u30BF\u30FC\u306F\u898B\u3064\u304B\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u304C\u3001\u7121\u7406\u3084\u308A\u306A\u3089\u5145\u96FB\u3067\u304D\u305D\u3046\u3067\u3059\u3002"
    choice1Name: "\u5145\u96FB\u3059\u308B\u3002"
    choice1Description: "<color=#8A2BE2>\u6301\u7d9a</color>\uff1a\u653b\u6483\u529b\u304c<color=#32CD32>5%</color>\u5897\u52a0\u3057\u307e\u3059\u3002\n\u6700\u5927HP\u306e<color=#DC3132>30%</color>\u5206\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u307e\u3059\u3002"
    choice2Name: "\u7ACB\u3061\u53BB\u308B\u3002"
    choice2Description: "\u52B9\u679C\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.emergency_ration
    stageName: "\u8CDE\u5473\u671F\u9650\uFF1A\u4E09\u4E16\u7D00\u524D"
    stageDescription: "\u975E\u5E38\u98DF\u306E\u4FDD\u7BA1\u5EAB\u304C\u958B\u3044\u3066\u3044\u307E\u3059\u3002\n\u8CDE\u5473\u671F\u9650\u306F\u3068\u3046\u306B\u904E\u304E\u3001\u52D5\u7269\u306E\u990C\u306E\u3088\u3046\u306A\u5302\u3044\u304C\u3057\u307E\u3059\u304C\u3001\u4E2D\u8EAB\u306F\u7121\u4E8B\u306B\u898B\u3048\u307E\u3059\u3002"
    choice1Name: "\u98DF\u3079\u308B\u3002"
    choice1Description: "\u6700\u5927HP\u306e<color=#32CD32>30%</color>\u3092\u56de\u5fa9\u3057\u307e\u3059\u3002\n<color=#8A2BE2>\u6b21\u306e\u6226\u95d8\u306e\u307f</color>\uff1a\u9632\u5fa1\u529b\u304c<color=#DC3132>30%</color>\u6e1b\u5c11\u3057\u307e\u3059\u3002"
    choice2Name: "\u9759\u304B\u306B\u9589\u3058\u308B\u3002"
    choice2Description: "\u52B9\u679C\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.maintenance_Drone
    stageName: "\u6B4C\u3046\u6574\u5099\u30C9\u30ED\u30FC\u30F3"
    stageDescription: "\u6545\u969C\u3057\u305F\u6574\u5099\u30C9\u30ED\u30FC\u30F3\u304C\u5E8A\u306B\u8EE2\u304C\u308A\u3001\u8AB0\u304B\u306B\u4FEE\u7406\u3055\u308C\u308B\u306E\u3092\u5F85\u3061\u306A\u304C\u3089\u96FB\u5B50\u97F3\u3092\u9CF4\u3089\u3057\u3066\u3044\u307E\u3059\u3002\n\u805E\u304D\u7D9A\u3051\u3066\u3044\u308B\u3068\u3001\u3060\u3093\u3060\u3093\u6B4C\u306E\u3088\u3046\u306B\u3082\u601D\u3048\u3066\u304D\u307E\u3059\u3002"
    choice1Name: "\u4FEE\u7406\u3059\u308B\u3002"
    choice1Description: "<color=#8A2BE2>\u6301\u7d9a</color>\uff1a\u9632\u5fa1\u529b\u304c<color=#32CD32>10%</color>\u5897\u52a0\u3057\u307e\u3059\u3002"
    choice2Name: "\u30B3\u30A2\u3092\u53D6\u308A\u51FA\u3059\u3002"
    choice2Description: "<color=#32CD32>\u6574\u5099\u30c9\u30ed\u30fc\u30f3\u306e\u30b3\u30a2</color>\u3092\u7372\u5f97\u3057\u307e\u3059\u3002"
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.red_button
    stageName: "\u62BC\u3057\u3066\u306F\u3044\u3051\u306A\u3044\u30DC\u30BF\u30F3"
    stageDescription: "\u5ECA\u4E0B\u306E\u771F\u3093\u4E2D\u306B\u8D64\u3044\u30DC\u30BF\u30F3\u304C\u3042\u308A\u307E\u3059\u3002\n\u305D\u306E\u4E0B\u306B\u306F\u89AA\u5207\u306B\u3082\u300C\u62BC\u3059\u306A\u300D\u3068\u66F8\u304B\u308C\u3066\u3044\u307E\u3059\u3002"
    choice1Name: "\u62BC\u3059\u3002"
    choice1Description: "<color=#DAA520>\u30a8\u30ea\u30fc\u30c8\u30b9\u30c6\u30fc\u30b8</color>\u3078\u79fb\u52d5\u3057\u307e\u3059\u3002"
    choice2Name: "\u8B66\u544A\u3092\u5C0A\u91CD\u3059\u308B\u3002"
    choice2Description: "\u52B9\u679C\u306F\u3042\u308A\u307E\u305B\u3093\u3002"
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.unclaimed_locker
    stageName: "\u6301\u3061\u4E3B\u306E\u3044\u306A\u3044\u30ED\u30C3\u30AB\u30FC"
    stageDescription: "\u53E4\u3073\u305F\u30ED\u30C3\u30AB\u30FC\u3092\u898B\u3064\u3051\u307E\u3057\u305F\u3002\n\u8AB0\u306E\u3082\u306E\u304B\u306F\u5206\u304B\u308A\u307E\u305B\u3093\u304C\u3001\u9811\u4E08\u306A\u5357\u4EAC\u9320\u3067\u56FA\u304F\u9589\u3056\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\u3042\u306A\u305F\u306F\u614E\u91CD\u306B\u6697\u8A3C\u756A\u53F7\u3092\u63A8\u6E2C\u3057\u307E\u3059\u3002"
    choice1Name: "\u6697\u8A3C\u756A\u53F7\u3092\u63A8\u6E2C\u3059\u308B\u3002"
    choice1Description: "50%\u306e\u78ba\u7387\u3067<color=#32CD32>\u30e9\u30f3\u30c0\u30e0\u306a\u30e6\u30cb\u30fc\u30af\u7b49\u7d1a\u88c5\u5099\u30921\u500b</color>\u7372\u5f97\u3057\u307e\u3059\u3002"
    choice2Name: "\u7121\u7406\u3084\u308A\u958B\u3051\u308B\u3002"
    choice2Description: "<color=#32CD32>\u30e9\u30f3\u30c0\u30e0\u306a\u4e0a\u7d1a\u7b49\u7d1a\u88c5\u5099\u30922\u500b</color>\u7372\u5f97\u3057\u307e\u3059\u3002"
    choice3Name: 
    choice3Description: 
  - stageId: stage.unknown.magnetic_storm
