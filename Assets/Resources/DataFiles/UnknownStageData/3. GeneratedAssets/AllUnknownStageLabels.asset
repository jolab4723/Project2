    choice1Description: "<color=#8A2BE2>\u6301\u7eed</color>\uff1a\u653b\u51fb\u529b\u63d0\u9ad8<color=#32CD32>5%</color>\u3002\n\u6700\u5927\u751f\u547d\u503c\u964d\u4f4e<color=#DC3132>5%</color>\u3002"
