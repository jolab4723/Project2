  - uniqueEffectId: UE_WasteHeatDischarge
    name: "\u5EC3\u71B1\u653E\u51FA"
    description: "\u7570\u306A\u308B\u901A\u5E38\u653B\u6483\u304C\u547D\u4E2D\u3059\u308B\u305F\u3073\u306B\u71B1\u30921\u84C4\u7A4D\u3057\u3001\u6700\u5927{0}\u307E\u3067\u30C1\u30E3\u30FC\u30B8\u3057\u307E\u3059\u3002\u30C1\u30E3\u30FC\u30B8\u5B8C\u4E86\u5F8C\u306E\u6B21\u306E\u6709\u52B9\u306A\u901A\u5E38\u653B\u6483\u3067\u71B1\u3092\u3059\u3079\u3066\u6D88\u8CBB\u3057\u3001\u524D\u65B9{1}m\u30FB\u5168\u89D2{2}\xB0\u5185\u306E\u6575\u6700\u5927{4}\u4F53\u306B\u653B\u6483\u529B\u306E{3}%\u306E\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u306A\u3057\u306E\u708E\u30C0\u30E1\u30FC\u30B8\u3092\u8FFD\u52A0\u3067\u4E0E\u3048\u307E\u3059\u3002\u901A\u5E38\u653B\u6483\u304C{5}\u79D2\u9593\u547D\u4E2D\u3057\u306A\u3044\u3068\u71B1\u304C\u6D88\u5931\u3057\u307E\u3059\u3002"
