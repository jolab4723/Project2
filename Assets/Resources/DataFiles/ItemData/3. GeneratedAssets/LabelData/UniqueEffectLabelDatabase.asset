  - uniqueEffectId: UE_PhaseHarvesterWave
    name: "\u865A\u7A7A\u5904\u51B3\u6CE2"
    description: "\u6597\u58EB\u666E\u901A\u653B\u51FB\u51FB\u6740\u654C\u4EBA\u540E\uFF0C\u7ACB\u5373\u4ECE\u51FB\u6740\u4F4D\u7F6E\u5411\u524D\u5F62\u6210\u957F{0}\u7C73\u3001\u5BBD{1}\u7C73\u7684\u5904\u51B3\u901A\u9053\u3002\u5BF9\u6700\u591A{3}\u4E2A\u5B58\u6D3B\u654C\u4EBA\u5404\u9020\u6210\u4E00\u6B21{2}%\u65E0\u5C5E\u6027\u4F24\u5BB3\uFF0C\u4E0D\u4F1A\u66B4\u51FB\u6216\u8FDE\u9501\u89E6\u53D1\u3002\u51B7\u5374\u65F6\u95F4\u4E3A{4}\u79D2\u3002"
  - uniqueEffectId: UE_StarforgeBreachExplosion
    name: "\u661F\u8FB0\u7834\u9635\u8005\u8FD1\u8DDD\u79BB\u7206\u70B8"
    description: "\u67AA\u624B\u7684\u666E\u901A\u9730\u5F39\u67AA\u653B\u51FB\u547D\u4E2D\u8DDD\u53D1\u5C04\u4F4D\u7F6E{0}m\u4EE5\u5185\u7684\u654C\u4EBA\u65F6\uFF0C\u5728\u547D\u4E2D\u4F4D\u7F6E\u5F15\u53D1\u534A\u5F84{1}m\u7684\u7206\u70B8\u3002\u5BF9\u6700\u591A{3}\u4E2A\u654C\u4EBA\u9020\u6210\u4E00\u6B21{2}%\u706B\u7130\u4F24\u5BB3\uFF0C\u4E0D\u4F1A\u66B4\u51FB\u3002\u51B7\u5374\u65F6\u95F4\uFF1A{4}\u79D2\u3002"
  - uniqueEffectId: UE_WasteHeatDischarge
    name: "\u5E9F\u70ED\u91CA\u653E"
    description: "\u6BCF\u6B21\u4E0D\u540C\u7684\u666E\u901A\u653B\u51FB\u547D\u4E2D\u65F6\u79EF\u7D2F1\u70B9\u70ED\u91CF\uFF0C\u6700\u591A{0}\u70B9\u3002\u5145\u6EE1\u540E\uFF0C\u4E0B\u6B21\u6709\u6548\u666E\u901A\u653B\u51FB\u6D88\u8017\u5168\u90E8\u70ED\u91CF\uFF0C\u5BF9\u524D\u65B9{1}\u7C73\u3001\u603B\u5939\u89D2{2}\xB0\u5185\u6700\u591A{4}\u4E2A\u654C\u4EBA\u989D\u5916\u9020\u6210\u653B\u51FB\u529B{3}%\u7684\u65E0\u6CD5\u66B4\u51FB\u7684\u706B\u7130\u4F24\u5BB3\u3002{5}\u79D2\u5185\u6CA1\u6709\u666E\u901A\u653B\u51FB\u547D\u4E2D\u65F6\uFF0C\u70ED\u91CF\u6E05\u7A7A\u3002"
