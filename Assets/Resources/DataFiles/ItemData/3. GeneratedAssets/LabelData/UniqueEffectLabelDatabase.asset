  - uniqueEffectId: UE_PreciousMetalDetector
    name: "\u6838\u5FC3\u63A2\u6D4B"
    description: "\u7269\u54C1\u6389\u843D\u65F6\uFF0C\u7A00\u6709\u3001\u72EC\u7279\u548C\u4F20\u8BF4\u54C1\u8D28\u7684\u6743\u91CD\u5404\u4E58\u4EE5{0:F1}\u3002\u6574\u4F53\u7269\u54C1\u6389\u843D\u6982\u7387\u4E0D\u53D8\uFF1B\u82E5\u540C\u65F6\u6301\u6709\u500D\u7387\u66F4\u9AD8\u7684\u6548\u679C\uFF0C\u5219\u4EC5\u9002\u7528\u8BE5\u6548\u679C\u3002"
