  jpnLabels:
  - uniqueEffectId: UE_QuantumShoes
    name: "\u30AF\u30A9\u30F3\u30BF\u30E0\u30D6\u30FC\u30B9\u30C8"
    description: "\u79FB\u52D5\u901F\u5EA6\u304C{0:F1}\u5897\u52A0\u3057\u307E\u3059\u3002"
