    description: "\u4F53\u529B\u304C{0}%\u4EE5\u4E0B\u306B\u306A\u308B\u3068\u79FB\u52D5\u901F\u5EA6\u304C{1}%\u5897\u52A0\u3057\u307E\u3059\u3002\u518D\u3073\u4E0A\u56DE\u308B\u3068\u89E3\u9664\u3055\u308C\u307E\u3059\u3002"
  - uniqueEffectId: UE_AdvancedCore
    name: "\u5897\u5F37"
    description: "\u6700\u5927HP\u304C{0}\u4E0A\u6607\u3057\u307E\u3059\u3002"
  - uniqueEffectId: UE_CyberneticCore
    name: "\u57FA\u790E\u7684\u306A\u30A4\u30F3\u30D7\u30E9\u30F3\u30C8"
    description: "\u56DE\u907F\u4F7F\u7528\u6642\u3001\u795E\u7D4C\u52A0\u901F\u30E2\u30FC\u30C9\u306B\u5165\u308A\u307E\u3059\u3002{0}\u79D2\u9593\u79FB\u52D5\u901F\u5EA6\u304C{1}\u5897\u52A0\u3057\u307E\u3059\u3002\uFF08\u30AF\u30FC\u30EB\u30C0\u30A6\u30F3\uFF1A{2}\u79D2\uFF09"
  - uniqueEffectId: UE_LightSaber
    name: "\u5149\u5B50\u52A0\u901F"
