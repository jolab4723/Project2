  - itemId: item.weapon.shotgun.flamethrower
    name: "\uBD88\uAF43 \uBD84\uC0AC\uAE30"
    description: "\uBD88\uAF43\uC744 \uC5EC\uB7EC\uAC08\uB798\uB85C \uC3D8\uC544\uB311\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.mechanicaldestroyer
    name: "\uAE30\uACC4 \uD30C\uAD34\uC790"
    description: "\uB2E8\uB2E8\uD55C \uAE30\uACC4\uB4E4\uC744 \uBB34\uC790\uBE44\uD558\uAC8C
      \uD30C\uAD34\uD560 \uC218 \uC788\uB294 \uBB34\uAE30\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.treebranch
    name: "\uB098\uBB47\uAC00\uC9C0"
    description: "\uAE38\uAC70\uB9AC\uC5D0 \uAD74\uB7EC\uB2E4\uB2D0 \uBC95\uD55C
      \uB098\uBB47\uAC00\uC9C0\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.basic
    name: "\uAE30\uBCF8 \uD5EC\uBA67"
    description: "\uD3C9\uBC94\uD55C \uD5EC\uBA67\uC785\uB2C8\uB2E4."
  - itemId: item.armor.chest.sturdy
    name: "\uACAC\uACE0\uD55C \uAC11\uC637"
    description: "\uD2BC\uD2BC\uD55C \uAC11\uC637\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.ninja_movement
    name: "\uB2CC\uC790\uC758 \uC6C0\uC9C1\uC784"
    description: "\uC804\uC124\uC801\uC778 \uB2CC\uC790\uC758 \uC6C0\uC9C1\uC784\uC744
      \uC7AC\uD604\uD558\uB3C4\uB85D \uC124\uACC4\uB41C \uD2B9\uC218 \uC804\uD22C\uD654\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.quantum_shoes
    name: "\uD000\uD140 \uC288\uC988"
    description: "\uD558\uC774-\uD14C\uD06C\uB180\uB85C\uC9C0\uAC00 \uD0D1\uC7AC\uB41C
      \uC2E0\uBC1C\uC785\uB2C8\uB2E4."
  - itemId: item.potion.red
    name: "\uBE68\uAC04 \uBB3C\uC57D"
    description: "\uD3EC\uC158\uC785\uB2C8\uB2E4."
  - itemId: item.relic.mass-produced_core
    name: "\uC591\uC0B0\uD615 \uCF54\uC5B4"
    description: "\uACF5\uC7A5\uC5D0\uC11C \uCC0D\uC5B4\uB0B8 \uAE30\uACC4\uC7A5\uCE58\uC758
      \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  - itemId: item.relic.advanced_core
    name: "\uACE0\uAE09 \uCF54\uC5B4"
    description: "\uBCF4\uD1B5\uC758 \uCF54\uC5B4\uBCF4\uB2E4 \uCD9C\uB825\uC774
      \uB192\uC740 \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.noentrysign
    name: "\uC9C4\uC785 \uAE08\uC9C0 \uD45C\uC9C0\uD310"
    description: "\uD788\uD788 \uBABB\uAC00"
  - itemId: item.weapon.axe.icecrusher
    name: "\uC544\uC774\uC2A4 \uD06C\uB7EC\uC154"
    description: "\uAC15\uB825\uD55C \uB0C9\uAE30\uB97C \uD488\uC740 \uB3C4\uB07C\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.axe.inferno
    name: "\uC778\uD398\uB974\uB178"
    description: "\uC774 \uB3C4\uB07C\uAC00 \uD488\uC740 \uD654\uC5FC\uC740 \uC801\uC5D0\uAC8C
      \uC9C0\uC625\uC744 \uC120\uC0AC\uD569\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.baseballbat
    name: "\uBE60\uB530"
    description: "\uC57C\uAD6C \uBE60\uB530\uB97C \uC804\uD22C\uC6A9\uC73C\uB85C
      \uAC1C\uC870\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.lightsaber
    name: "\uB77C\uC774\uD2B8\uC138\uC774\uBC84"
    description: "\uAD11\uC120\uAC80\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.crusader
    name: "\uD06C\uB8E8\uC138\uC774\uB354"
    description: "\uC131\uC2A4\uB7EC\uC6B4 \uC77C\uACA9\uC744 \uB0A0\uB9B4 \uC218
      \uC788\uB294 \uB300\uAC80\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.guardiansjustice
    name: "\uC218\uD638\uC790\uC758 \uC815\uC758"
    description: "\uC815\uC758\uB294 \uC2B9\uB9AC\uD55C\uB2E4!"
  - itemId: item.weapon.blunt.ironpipe
    name: "\uC1E0 \uD30C\uC774\uD504"
    description: "\uACE0\uCCA0 \uCC98\uB9AC\uC7A5\uC5D0\uC11C \uAC00\uC838\uC628
      \uB179 \uC2A8 \uD30C\uC774\uD504\uC785\uB2C8\uB2E4."
  - itemId: item.relic.cybernetic_core
    name: "\uC0AC\uC774\uBC84\uB124\uD2F1 \uCF54\uC5B4"
    description: "\uC2E0\uACBD\uACC4\uC5D0 \uC9C1\uC811 \uC5F0\uACB0\uB418\uB294
      \uAC15\uD654 \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.energyblade
    name: "\uC5D0\uB108\uC9C0 \uBE14\uB808\uC774\uB4DC"
    description: "E=mc\xB2. \uC774 \uAC80\uC740 \uADF8 \uACF5\uC2DD\uC774 \uC5BC\uB9C8\uB098
      \uC704\uD5D8\uD55C\uC9C0 \uAC00\uC7A5 \uC870\uC6A9\uD558\uAC8C \uC99D\uBA85\uD55C\uB2E4."
  - itemId: item.weapon.greatsword.zeroblade
    name: "\uC81C\uB85C \uBE14\uB808\uC774\uB4DC"
    description: "\uC808\uB300\uC601\uB3C4\uC5D0 \uAC00\uAE4C\uC6B4 \uB0C9\uAC01\uC7A5\uC744
      \uBC29\uCD9C\uD569\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.solarblade
    name: "\uC194\uB77C \uBE14\uB808\uC774\uB4DC"
    description: "\uD0DC\uC591\uC758 \uD575\uC735\uD569\uC744 \uBAA8\uBC29\uD55C
      \uD50C\uB77C\uC988\uB9C8 \uCE7C\uB0A0."
  - itemId: item.weapon.greatsword.voltblade
    name: "\uBCFC\uD2B8 \uBE14\uB808\uC774\uB4DC"
    description: "\uC218\uBC31\uB9CC \uBCFC\uD2B8\uC758 \uC804\uC704\uB97C \uD55C
      \uC904\uAE30\uB85C \uC555\uCD95\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.axe.heartofdebris
    name: "\uB370\uBE0C\uB9AC\uC2A4 \uC2EC\uC7A5 \uB3C4\uB07C"
    description: "\uB370\uBE0C\uB9AC\uC2A4-9\uC758 \uACB0\uC815\uCCB4\uAC00 \uC751\uCD95\uB41C
      \uC804\uC124 \uBB34\uAE30\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.wasteheatcleaver
    name: "\uD3D0\uC5F4 \uC808\uB2E8 \uB300\uAC80"
    description: "\uAC70\uB300\uD55C \uCE7C\uB0A0\uC740 \uD3D0\uC5F4\uC744 \uAC00\uC7A5\uC790\uB9AC\uC5D0
      \uC9D1\uC911\uC2DC\uCF1C \uACAC\uACE0\uD55C \uAE30\uACC4\uB3C4 \uC808\uB2E8\uD560
      \uC218 \uC788\uAC8C \uD574\uC90D\uB2C8\uB2E4."
  - itemId: item.weapon.axe.wildfire
    name: "\uC640\uC77C\uB4DC\uD30C\uC774\uC5B4"
    description: "\uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uBD88\uC528\uB97C \uD488\uC740
      \uB3C4\uB07C\uC785\uB2C8\uB2E4. \uD718\uB450\uB97C \uB54C\uB9C8\uB2E4 \uC7A0\uB4E4\uC5B4
      \uC788\uB358 \uC5F4\uAE30\uAC00 \uB2E4\uC2DC \uD0C0\uC624\uB985\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.thighbone
    name: "\uC6B0\uC8FC \uAD34\uBB3C \uB300\uD1F4\uACE8"
    description: "\uC815\uCCB4\uBD88\uBA85\uC758 \uC6B0\uC8FC \uAD34\uBB3C\uC5D0\uAC8C\uC11C
      \uB098\uC628 \uB300\uD1F4\uACE8\uC785\uB2C8\uB2E4. \uBF08\uB77C\uACE0 \uBBFF\uAE30
      \uC5B4\uB824\uC6B8 \uB9CC\uD07C \uBB34\uAC81\uACE0 \uB2E8\uB2E8\uD569\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.superrefrigerant
    name: "\uCD08\uB0C9\uB9E4"
    description: "\uADF9\uC800\uC628\uC758 \uB0C9\uB9E4\uAC00 \uBD09\uC778\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4. \uCDA9\uACA9\uC744 \uBC1B\uC744 \uB54C\uB9C8\uB2E4
      \uC8FC\uBCC0\uC758 \uC5F4\uC744 \uBB34\uC790\uBE44\uD558\uAC8C \uBE7C\uC557\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.morningstar
    name: "\uC544\uCE68\uC758 \uBCC4"
    description: "\uC0C8\uBCBD\uD558\uB298\uC5D0\uC11C \uAC00\uC7A5 \uBC1D\uAC8C
      \uBE5B\uB098\uB294 \uBCC4\uC758 \uC774\uB984\uC744 \uAC00\uC9C4 \uBB34\uAE30\uC785\uB2C8\uB2E4.
      \uB9DE\uC740 \uC0AC\uB78C\uB3C4 \uC7A0\uC2DC \uBCC4\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.magicstaff
    name: "\uB9C8\uBC95(\uBB3C\uB9AC) \uC9C0\uD321\uC774"
    description: "\uB9C8\uB825\uC774 \uC5C6\uC5B4\uB3C4 \uC0AC\uC6A9\uD560 \uC218
      \uC788\uB294 \uB9C8\uBC95 \uC9C0\uD321\uC774\uC785\uB2C8\uB2E4. \uC8FC\uBB38\uC740
      \uAC04\uB2E8\uD569\uB2C8\uB2E4. \uD798\uAECF \uD718\uB450\uB974\uC138\uC694."
  - itemId: item.weapon.greatsword.nightsword
    name: "\uBC24\uC758 \uCE7C\uB0A0"
    description: "\uBE5B\uC744 \uC0BC\uD0A8 \uB4EF \uAC80\uAC8C \uBB3C\uB4E0 \uB300\uAC80\uC785\uB2C8\uB2E4.
      \uC5B4\uB460 \uC18D\uC5D0\uC11C\uB294 \uCE7C\uB0A0\uC758 \uACBD\uACC4\uC870\uCC28
      \uD750\uB9BF\uD574\uC9D1\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.rusty
    name: "\uB179\uC2A8 \uB300\uAC80"
    description: "\uB179\uC774 \uC2AC\uACE0 \uB0A0\uB3C4 \uBB34\uB38C\uC9C4 \uB0A1\uC740
      \uB300\uAC80\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.discardedboostermodule
    name: "\uD3D0\uAE30\uB41C \uBD80\uC2A4\uD130 \uBAA8\uB4C8"
    description: "\uD3D0\uAE30\uB41C \uAE30\uB3D9 \uB85C\uBD07\uC5D0\uC11C \uB5BC\uC5B4\uB0B8
      \uBD80\uC2A4\uD130 \uBAA8\uB4C8\uC785\uB2C8\uB2E4. \uC548\uC804 \uAE30\uC900\uC740
      \uCDA9\uC871\uD558\uC9C0 \uBABB\uD588\uC9C0\uB9CC, \uC18D\uB3C4 \uAE30\uC900\uC740
      \uD655\uC2E4\uD788 \uCDA9\uC871\uD569\uB2C8\uB2E4."
  - itemId: item.armor.helmet.signaljammer
    name: "\uAD70\uC9D1 \uC2E0\uD638 \uAD50\uB780\uAE30"
    description: "\uC8FC\uBCC0\uC758 \uAD70\uC9D1 \uD1B5\uC2E0 \uC2E0\uD638\uC5D0
      \uC7A1\uC74C\uC744 \uC11E\uC5B4 \uB123\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4.
      \uC801\uB4E4\uC740 \uD63C\uB780\uC2A4\uB7EC\uC6CC\uC9C0\uACE0, \uCC29\uC6A9\uC790\uB294
      \uBA38\uB9AC\uAC00 \uC870\uAE08 \uC544\uD30C\uC9D1\uB2C8\uB2E4."
  - itemId: item.armor.chest.solargrace
    name: "\uD0DC\uC591\uC758 \uC740\uD61C"
    description: "\uD0DC\uC591 \uC5D0\uB108\uC9C0\uB97C \uD761\uC218\uD574 \uCC29\uC6A9\uC790\uB97C
      \uBCF4\uD638\uD558\uB294 \uAC11\uC637\uC785\uB2C8\uB2E4. \uBCC4 \uD558\uB098\uAC00
      \uBCF4\uB0B4\uB294 \uC740\uD61C\uCE58\uACE0\uB294 \uAF64\uB098 \uB728\uAC81\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.axe.phaseharvester
    name: "\uACF5\uD5C8\uC758 \uC218\uD655\uC790"
    description: "\uACF5\uD5C8 \uC5D0\uB108\uC9C0\uB97C \uCE7C\uB0A0 \uD615\uD0DC\uB85C
      \uC555\uCD95\uD55C \uC804\uD22C\uC6A9 \uB0AB\uC785\uB2C8\uB2E4. \uD55C \uBC88
      \uD718\uB450\uB97C \uB54C\uB9C8\uB2E4 \uBCF4\uB78F\uBE5B \uADA4\uC801\uC774
      \uACF5\uAC04\uACFC \uC7A5\uAC11\uC744 \uD568\uAED8 \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.arcblade
    name: "\uC544\uD06C \uBE14\uB808\uC774\uB4DC"
    description: "\uAC80\uC2E0\uC744 \uB530\uB77C \uACE0\uC804\uC555 \uC804\uB958\uB97C
      \uC21C\uD658\uC2DC\uD0A4\uB294 \uC804\uD22C\uC6A9 \uB3C4\uAC80\uC785\uB2C8\uB2E4.
      \uC808\uB2E8\uBA74\uC73C\uB85C \uBC29\uC804\uB41C \uC804\uB958\uAC00 \uB0B4\uBD80
      \uD68C\uB85C\uAE4C\uC9C0 \uD30C\uACE0\uB4ED\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.corebreaker
    name: "\uCF54\uC5B4 \uBE0C\uB808\uC774\uCEE4"
    description: "\uC911\uC559 \uB3D9\uB825\uD575\uC758 \uCD9C\uB825\uC744 \uAC80\uC2E0
      \uC804\uCCB4\uC5D0 \uBC29\uCD9C\uD558\uB294 \uB300\uD615 \uBCD1\uAE30\uC785\uB2C8\uB2E4.
      \uC678\uC7A5\uAC11\uC744 \uBD80\uC218\uB294 \uAC83\uC740 \uC2DC\uC791\uC77C
      \uBFD0, \uC9C4\uC9DC \uBAA9\uD45C\uB294 \uADF8 \uC548\uCABD\uC758 \uB3D9\uB825
      \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.chainsaw
    name: "\uCCB4\uC778\uC18C"
    description: "\uD3D0\uAE30 \uB85C\uBD07\uC758 \uC7A5\uAC11\uC744 \uC808\uB2E8\uD558\uAE30
      \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC9C4 \uC0B0\uC5C5\uC6A9 \uACF5\uAD6C\uC785\uB2C8\uB2E4.
      \uC804\uC7C1\uD130\uC5D0\uC11C\uB294 \uAD73\uC774 \uD3D0\uAE30 \uD310\uC815\uC744
      \uAE30\uB2E4\uB9B4 \uD544\uC694\uAC00 \uC5C6\uB2E4\uB294 \uC0AC\uC2E4\uC774
      \uBC1D\uD600\uC84C\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.shovel
    name: "\uAC15\uC81C \uC815\uBE44 \uB3C4\uAD6C"
    description: "\uC57C\uC804 \uC815\uBE44\uBC18\uC5D0\uC11C \uC0AC\uC6A9\uD558\uB358
      \uB2E4\uBAA9\uC801 \uC911\uC7A5\uBE44\uC785\uB2C8\uB2E4. \uC815\uC0C1\uC801\uC778
      \uC815\uBE44 \uC808\uCC28\uB85C \uD574\uACB0\uB418\uC9C0 \uC54A\uB294 \uAE30\uACC4\uB294
      \uCDA9\uBD84\uD55C \uC6B4\uB3D9\uC5D0\uB108\uC9C0\uB97C \uAC00\uD558\uBA74
      \uB300\uAC1C \uC870\uC6A9\uD574\uC9D1\uB2C8\uB2E4."
  - itemId: item.armor.helmet.improvisedheadguard
    name: "\uAE09\uC870 \uBA38\uB9AC \uBCF4\uD638\uB300"
    description: "\uC8FC\uBCC0\uC5D0\uC11C \uAD6C\uD55C \uC7AC\uB8CC\uB97C \uC5EE\uC5B4
      \uB9CC\uB4E0 \uC784\uC2DC \uBCF4\uD638\uAD6C\uC785\uB2C8\uB2E4. \uBBFF\uC74C\uC9C1\uC2A4\uB7FD\uC9C4
      \uC54A\uC9C0\uB9CC, \uB9E8\uBA38\uB9AC\uBCF4\uB2E4\uB294 \uB0AB\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.chest.woodenarmor
    name: "\uB098\uBB34 \uAC11\uC637"
    description: "\uC5EC\uB7EC \uC7A5\uC758 \uBAA9\uC7AC\uB97C \uC774\uC5B4 \uBD99\uC5EC
      \uB9CC\uB4E0 \uAC11\uC637\uC785\uB2C8\uB2E4. \uCD1D\uC54C\uC744 \uB9C9\uAE30\uC5D4
      \uBD80\uC871\uD558\uC9C0\uB9CC, \uAC00\uBCBC\uC6B4 \uCDA9\uACA9 \uC815\uB3C4\uB294
      \uBC1B\uC544\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.helmet.steelheadguard
    name: "\uCCA0\uD310 \uBCF4\uD638\uB300"
    description: "\uC587\uC740 \uCCA0\uD310\uC744 \uBA38\uB9AC \uD615\uD0DC\uC5D0
      \uB9DE\uCDB0 \uC774\uC5B4 \uBD99\uC778 \uBCF4\uD638\uAD6C\uC785\uB2C8\uB2E4.
      \uAE09\uC870\uD488\uBCF4\uB2E4 \uBB34\uAC81\uC9C0\uB9CC, \uADF8\uB9CC\uD07C
      \uD6E8\uC52C \uB2E8\uB2E8\uD569\uB2C8\uB2E4."
  - itemId: item.armor.chest.steelarmor
    name: "\uCCA0\uD310 \uAC11\uC637"
    description: "\uC5EC\uB7EC \uACB9\uC758 \uCCA0\uD310\uC744 \uACB9\uCCD0 \uB9CC\uB4E0
      \uB2E8\uC21C\uD55C \uAC11\uC637\uC785\uB2C8\uB2E4. \uB85C\uBD07\uC758 \uACF5\uACA9\uC744
      \uC815\uBA74\uC73C\uB85C \uBC1B\uC544\uB0BC \uC5EC\uC720\uAC00 \uC870\uAE08
      \uC0DD\uAE41\uB2C8\uB2E4."
  - itemId: item.armor.helmet.cauldronhelmet
    name: "\uAC00\uB9C8\uC1A5 \uD22C\uAD6C"
    description: "\uB450\uAEBC\uC6B4 \uAE08\uC18D \uAC00\uB9C8\uC1A5\uC744 \uBA38\uB9AC\uC5D0
      \uB4A4\uC9D1\uC5B4\uC4F4 \uD22C\uAD6C\uC785\uB2C8\uB2E4. \uC6D0\uB798 \uC6A9\uB3C4\uBCF4\uB2E4
      \uC9C0\uAE08\uC774 \uB354 \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.chest.basic
    name: "\uAE30\uBCF8 \uC637"
    description: "\uD3C9\uBC94\uD55C \uC637\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.basic
    name: "\uAE30\uBCF8 \uBD80\uCE20"
    description: "\uD3C9\uBC94\uD55C \uBD80\uCE20\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.lightweight
    name: "\uACBD\uB7C9 \uC548\uC804\uD654"
    description: "\uBD88\uD544\uC694\uD55C \uBCF4\uD638\uD310\uC744 \uC81C\uAC70\uD574
      \uBB34\uAC8C\uB97C \uC904\uC778 \uC791\uC5C5\uC6A9 \uC548\uC804\uD654\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.poweredassist
    name: "\uB3D9\uB825 \uBCF4\uC870 \uBD80\uCE20"
    description: "\uC18C\uD615 \uAD6C\uB3D9\uAE30\uAC00 \uCC29\uC6A9\uC790\uC758
      \uC774\uB3D9\uC744 \uBCF4\uC870\uD558\uB294 \uC791\uC5C5\uC6A9 \uBD80\uCE20\uC785\uB2C8\uB2E4.
      \uBB34\uAC70\uC6B4 \uC9D0\uC744 \uB098\uB974\uAE30 \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC84C\uC9C0\uB9CC,
      \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC77C \uB54C\uB3C4 \uAF64 \uC720\uC6A9\uD569\uB2C8\uB2E4."
  - itemId: item.relic.scrapcompactor
    name: "\uACE0\uCCA0 \uC555\uCD95\uAE30"
    description: "\uD30C\uAD34\uB41C \uAE30\uACC4\uC758 \uC794\uD574\uB97C \uC555\uCD95\uD574
      \uC7AC\uD65C\uC6A9\uD558\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4. \uC804\uC7A5\uC5D0\uB294
      \uC6D0\uB8CC\uAC00 \uB118\uCCD0\uB0A9\uB2C8\uB2E4."
  - itemId: item.relic.overclockcore
    name: "\uC624\uBC84\uD074\uB7ED \uCF54\uC5B4"
    description: "\uC548\uC804 \uD55C\uACC4\uB97C \uBB34\uC2DC\uD558\uACE0 \uCD9C\uB825\uC744
      \uB04C\uC5B4\uC62C\uB9AC\uB294 \uAC1C\uC870 \uB3D9\uB825 \uCF54\uC5B4\uC785\uB2C8\uB2E4.
      \uC131\uB2A5\uC744 \uC5BB\uB294 \uB370\uC5D0\uB294 \uC5B8\uC81C\uB098 \uB300\uAC00\uAC00
      \uB530\uB985\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.conveyercleaver
    name: "\uCEE8\uBCA0\uC774\uC5B4 \uC808\uB2E8\uAC80"
    description: "\uD3D0\uACF5\uC7A5 \uCEE8\uBCA0\uC774\uC5B4\uC758 \uC808\uB2E8\uB0A0\uC744
      \uB5BC\uC5B4 \uC190\uC7A1\uC774\uB97C \uB2EC\uC558\uC2B5\uB2C8\uB2E4. \uC548\uC804
      \uB36E\uAC1C\uB294 \uBB34\uAC8C \uB54C\uBB38\uC5D0 \uBC84\uB838\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.sharpgreatsword
    name: "\uB0A0\uCE74\uB85C\uC6B4 \uB300\uAC80"
    description: "\uB0A0\uC744 \uC81C\uB300\uB85C \uC138\uC6B4 \uBB35\uC9C1\uD55C
      \uB300\uAC80\uC785\uB2C8\uB2E4. \uC801\uC5B4\uB3C4 \uC774\uBC88\uC5D0\uB294
      \uBCA0\uB294 \uC6A9\uB3C4\uB85C \uB9CC\uB4E4\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.ceremonialsword
    name: "\uC758\uC2DD\uC6A9 \uAC80"
    description: "\uC0AC\uC774\uBA3C\uC758 \uACF5\uC7A5 \uC900\uACF5\uC2DD\uC5D0
      \uC0AC\uC6A9\uB41C \uC758\uC7A5\uAC80\uC785\uB2C8\uB2E4. \uCD95\uC0AC\uAC00
      \uB05D\uB09C \uB4A4\uC5D0\uB3C4 \uCE7C\uB0A0\uC740 \uC798 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.magneticrailblade
    name: "\uC790\uAE30 \uB808\uC77C \uBE14\uB808\uC774\uB4DC"
    description: "\uC790\uAE30 \uB808\uC77C\uC774 \uCE7C\uB0A0\uC744 \uB530\uB77C
      \uBC29\uC804\uC744 \uBC00\uC5B4\uB0B4\uBA70 \uC808\uB2E8\uB825\uC744 \uB192\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.simonslastcontract
    name: "\uC0AC\uC774\uBA3C\uC758 \uB9C8\uC9C0\uB9C9 \uACC4\uC57D"
    description: "\uC0AC\uC774\uBA3C\uC774 \uD589\uC131\uC744 \uB9E4\uC785\uD560
      \uB54C \uC11C\uBA85\uD55C \uACC4\uC57D\uC11C\uB97C \uC7A5\uAC11\uD310 \uC0AC\uC774\uC5D0
      \uBD09\uC778\uD55C \uB300\uAC80\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.greatsword.planetdeedbreaker
    name: "\uD589\uC131 \uAD8C\uB9AC\uC99D \uD30C\uC1C4\uAC80"
    description: "\uD589\uC131 \uC18C\uC720\uAD8C \uC99D\uC11C\uB97C \uD30C\uAE30\uD558\uAE30
      \uC704\uD574 \uB9CC\uB4E0 \uB4EF\uD55C \uAC70\uB300\uD55C \uC5F4\uC120 \uB300\uAC80\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.torquewrench
    name: "\uD1A0\uD06C \uB80C\uCE58"
    description: "\uC815\uBE44\uC6A9 \uB300\uD615 \uD1A0\uD06C \uB80C\uCE58\uC785\uB2C8\uB2E4.
      \uADDC\uC815 \uD1A0\uD06C\uB97C \uB118\uAE30\uBA74 \uB300\uBD80\uBD84\uC758
      \uBB38\uC81C\uAC00 \uBD84\uD574\uB429\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.managerriotbaton
    name: "\uAD00\uB9AC\uC790 \uC9C4\uC555\uBD09"
    description: "\uD3D0\uACF5\uC7A5 \uAD00\uB9AC\uC790\uAC00 \uC18C\uC694 \uC0AC\uD0DC\uC5D0
      \uB300\uBE44\uD574 \uC9C0\uAE09\uBC1B\uC558\uB358 \uC9C4\uC555\uBD09\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.hydraulicpiledriver
    name: "\uC720\uC555 \uD30C\uC77C \uB4DC\uB77C\uC774\uBC84"
    description: "\uC720\uC555 \uC2E4\uB9B0\uB354\uAC00 \uD0C0\uACA9 \uC21C\uAC04
      \uCCA0\uC2EC\uC744 \uBC00\uC5B4\uB0B4\uB294 \uD574\uCCB4 \uACF5\uAD6C\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.magneticstormhammer
    name: "\uC790\uAE30 \uD3ED\uD48D \uD574\uBA38"
    description: "\uC790\uAE30 \uD3ED\uD48D \uC18D\uC5D0\uC11C \uCDA9\uC804\uB41C
      \uCF54\uC77C \uD574\uBA38\uC785\uB2C8\uB2E4. \uD718\uB450\uB97C \uB54C\uB9C8\uB2E4
      \uACF5\uAE30\uAC00 \uBA3C\uC800 \uC6B8\uB9BD\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.refunddenied
    name: "\uD658\uBD88 \uAC70\uBD80"
    description: "\uC70C\uB9AC\uC5C4\uC0AC\uC758 \uD658\uBD88 \uCC3D\uAD6C\uC5D0\uC11C
      \uC0AC\uC6A9\uD558\uB358 \uCD5C\uC885 \uB2F5\uBCC0\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.lastwarningbell
    name: "\uCD5C\uD6C4 \uD1B5\uBCF4\uC758 \uC885"
    description: "\uAD50\uB300 \uC885\uB8CC\uB97C \uC54C\uB9AC\uB358 \uAC70\uB300\uD55C
      \uC885\uC785\uB2C8\uB2E4. \uC9C0\uAE08\uC740 \uC801\uC758 \uADFC\uBB34\uB3C4
      \uD568\uAED8 \uB05D\uB0C5\uB2C8\uB2E4."
  - itemId: item.weapon.axe.emergencyrescueaxe
    name: "\uBE44\uC0C1 \uAD6C\uC870 \uB3C4\uB07C"
    description: "\uBE44\uC0C1\uD568\uC5D0\uC11C \uAEBC\uB0B8 \uC591\uC190 \uAD6C\uC870
      \uB3C4\uB07C\uC785\uB2C8\uB2E4. \uBB38\uACFC \uB85C\uBD07 \uBAA8\uB450 \uBE44\uC2B7\uD558\uAC8C
      \uC5F4\uB9BD\uB2C8\uB2E4."
  - itemId: item.weapon.axe.scrapsorter
    name: "\uACE0\uCCA0 \uBD84\uB958 \uB3C4\uB07C"
    description: "\uACE0\uCCA0 \uBD84\uB958 \uB77C\uC778\uC758 \uC808\uB2E8\uAE30\uB97C
      \uB3C4\uB07C\uB85C \uAC1C\uC870\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.axe.excavatortooth
    name: "\uAD74\uCC29\uAE30 \uC774\uBE68"
    description: "\uD3EC\uD06C\uB808\uC778\uC758 \uB9C8\uBAA8\uB41C \uBC84\uD0B7
      \uC774\uBE68\uC744 \uB5BC\uC5B4 \uB9CC\uB4E0 \uB3C4\uB07C\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.axe.maintenancedronewing
    name: "\uC815\uBE44 \uB4DC\uB860\uC758 \uB0A0\uAC1C"
    description: "\uACE0\uC7A5 \uB09C \uC815\uBE44 \uB4DC\uB860\uC758 \uB0A0\uAC1C
      \uD504\uB808\uC784\uC744 \uC591\uB0A0 \uB3C4\uB07C\uB85C \uC7AC\uC870\uB9BD\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.weapon.axe.antimattersplitter
    name: "\uBC18\uBB3C\uC9C8 \uBD84\uC5F4\uB3C4\uB07C"
    description: "\uC11C\uB85C \uB2FF\uC544\uC11C\uB294 \uC548 \uB420 \uBB3C\uC9C8\uC744
      \uB0A0 \uC591\uCABD\uC5D0 \uAC00\uB454 \uC2E4\uD5D8\uC6A9 \uB3C4\uB07C\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.axe.finalinvoice
    name: "\uCD5C\uC885 \uCCAD\uAD6C\uC11C"
    description: "\uC0AC\uC774\uBA3C\uC758 \uB9C8\uC9C0\uB9C9 \uBBF8\uC218\uAE08\uC774
      \uC801\uD78C \uCCAD\uAD6C\uC11C\uC640 \uD568\uAED8 \uBC1C\uACAC\uB41C \uCC98\uD615\uC6A9
      \uB3C4\uB07C\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.foilsignalcap
    name: "\uC804\uD30C \uCC28\uB2E8 \uD3EC\uC77C \uBAA8\uC790"
    description: "\uC2DD\uD488 \uD3EC\uC7A5\uC6A9 \uD3EC\uC77C\uACFC \uD3D0\uC804\uC120\uC744
      \uACB9\uCCD0 \uB9CC\uB4E0 \uBAA8\uC790\uC785\uB2C8\uB2E4. \uC2E0\uD638\uB294
      \uB9C9\uC9C0\uB9CC \uC2DC\uC120\uC740 \uB9C9\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
  - itemId: item.armor.helmet.crackedweldingmask
    name: "\uAE08 \uAC04 \uC6A9\uC811 \uB9C8\uC2A4\uD06C"
    description: "\uC6A9\uC811 \uBD88\uAF43 \uC790\uAD6D\uACFC \uADE0\uC5F4\uC774
      \uB0A8\uC740 \uC791\uC5C5\uC6A9 \uC548\uBA74 \uBCF4\uD638\uAD6C\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.reinforcedironmask
    name: "\uAC1C\uB7C9\uD615 \uCCA0\uAC00\uBA74"
    description: "\uD3D0\uCCA0\uD310\uC744 \uB367\uB300\uC5B4 \uCDA9\uACA9 \uD761\uC218\uCE35\uC744
      \uBCF4\uAC15\uD55C \uCCA0\uAC00\uBA74\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.preciousmetaldetector
    name: "\uADC0\uAE08\uC18D \uD0D0\uC0C9\uAE30"
    description: "\uADC0\uAE08\uC18D\uBCF4\uB2E4 \uC0B4\uC544 \uC788\uB294 \uB3D9\uB825
      \uCF54\uC5B4\uC5D0 \uB354 \uBBFC\uAC10\uD558\uAC8C \uBC18\uC751\uD558\uB294
      \uD0D0\uC9C0\uAE30\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.militaryneuralstimulator
    name: "\uAD70\uC6A9 \uC2E0\uACBD \uC790\uADF9\uAE30"
    description: "\uAD70\uC6A9 \uBC18\uC751 \uC18D\uB3C4\uB97C \uB04C\uC5B4\uB0B4\uAE30
      \uC704\uD574 \uC2E0\uACBD \uC2E0\uD638\uB97C \uACFC\uD558\uAC8C \uC99D\uD3ED\uD569\uB2C8\uB2E4."
  - itemId: item.armor.helmet.unbearablestimulation
    name: "\uACAC\uB51C \uC218 \uC5C6\uB294 \uC790\uADF9"
    description: "\uACBD\uACE0 \uD55C\uACC4\uB97C \uC81C\uAC70\uD55C \uC2E0\uACBD
      \uC790\uADF9\uAE30\uC785\uB2C8\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4 \uBAB8\uC774
      \uBA3C\uC800 \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.incomprehensiblefear
    name: "\uBD88\uAC00\uD574\uD55C \uACF5\uD3EC"
    description: "\uCC29\uC6A9\uC790\uC758 \uACF5\uD3EC \uBC18\uC751\uC744 \uC804\uD22C
      \uC608\uCE21 \uC2E0\uD638\uB85C \uBC14\uAFB8\uB294 \uC815\uCCB4\uBD88\uBA85\uC758
      \uC7A5\uCE58\uC785\uB2C8\uB2E4."
  - itemId: item.armor.helmet.alienskullcrown
    name: "\uC6B0\uC8FC \uAD34\uBB3C \uB450\uAC1C\uACE8"
    description: "\uC6B0\uC8FC \uC0DD\uBB3C\uC758 \uB450\uAC1C\uACE8\uC5D0 \uC13C\uC11C\uC640
      \uC655\uAD00\uD615 \uC804\uADF9\uC744 \uC774\uC2DD\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.chest.burnedmaintenancecoat
    name: "\uBD88\uD0C4 \uC815\uBE44 \uCF54\uD2B8"
    description: "\uD654\uC7AC \uD604\uC7A5\uC5D0\uC11C \uAC74\uC9C4 \uC815\uBE44
      \uCF54\uD2B8\uC785\uB2C8\uB2E4. \uADF8\uC744\uC74C \uC544\uB798\uC758 \uC12C\uC720\uCE35\uC740
      \uC544\uC9C1 \uBC84\uD301\uB2C8\uB2E4."
  - itemId: item.armor.chest.packagingfoamarmor
    name: "\uD3EC\uC7A5 \uC644\uCDA9\uC7AC \uAC11\uC637"
    description: "\uCDA9\uACA9 \uD3EC\uC7A5\uC7AC\uB97C \uC5EC\uB7EC \uACB9 \uC555\uCD95\uD574
      \uB9CC\uB4E0 \uAC11\uC637\uC785\uB2C8\uB2E4. \uBCF4\uAE30\uBCF4\uB2E4 \uD3EC\uADFC\uD558\uACE0
      \uB2E8\uB2E8\uD569\uB2C8\uB2E4."
  - itemId: item.armor.chest.ballisticfibersuit
    name: "\uBC29\uD0C4 \uC12C\uC720 \uC815\uC7A5"
    description: "\uACE0\uBC00\uB3C4 \uBC29\uD0C4 \uC12C\uC720\uB97C \uC791\uC5C5\uBCF5
      \uC548\uAC10\uC5D0 \uBD09\uD569\uD55C \uC2E4\uC804\uD615 \uC288\uD2B8\uC785\uB2C8\uB2E4."
  - itemId: item.armor.chest.spacemarinearmor
    name: "\uC6B0\uC8FC \uD574\uBCD1 \uAC11\uC637"
    description: "\uADA4\uB3C4 \uD574\uBCD1\uC6A9 \uC7A5\uAC11\uD310\uC744 \uC2A4\uCE90\uBE48\uC800
      \uCCB4\uD615\uC5D0 \uB9DE\uCDB0 \uB2E4\uC2DC \uC870\uB9BD\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.chest.alienobservationsuit
    name: "\uC6B0\uC8FC \uAD34\uBB3C \uAD00\uCC30\uBCF5"
    description: "\uC6B0\uC8FC \uC0DD\uBB3C\uC758 \uCCB4\uC561\uACFC \uD3EC\uC790\uB97C
      \uCC28\uB2E8\uD558\uB3C4\uB85D \uB9CC\uB4E0 \uBC00\uD3D0 \uAD00\uCC30\uBCF5\uC785\uB2C8\uB2E4."
  - itemId: item.armor.chest.energyarmor
    name: "\uC5D0\uB108\uC9C0 \uC544\uBA38"
    description: "\uC18C\uD615 \uBC1C\uC804\uAE30\uAC00 \uCDA9\uACA9 \uC21C\uAC04
      \uC5D0\uB108\uC9C0 \uBCF4\uD638\uB9C9\uC744 \uC804\uAC1C\uD569\uB2C8\uB2E4."
  - itemId: item.armor.chest.antimatterarmor
    name: "\uBC18\uBB3C\uC9C8 \uAC11\uC8FC"
    description: "\uBC18\uBB3C\uC9C8 \uACA9\uB0A9\uCE35\uC774 \uACF5\uACA9\uC744
      \uD758\uB824\uB0B4\uC9C0\uB9CC \uCC29\uC6A9\uC790\uC758 \uC0DD\uCCB4 \uC2E0\uD638\uB3C4
      \uC870\uAE08\uC529 \uAE4E\uC544\uB0C5\uB2C8\uB2E4."
  - itemId: item.armor.chest.portalcloak
    name: "\uCC28\uC6D0\uBB38 \uB9DD\uD1A0"
    description: "\uBBF8\uC138 \uCC28\uC6D0\uBB38\uC774 \uACF5\uACA9 \uADA4\uC801\uC744
      \uBE44\uAEF4\uAC00\uAC8C \uB9CC\uB4DC\uB294 \uC2E4\uD5D8\uC6A9 \uB9DD\uD1A0\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.oilproofworkboots
    name: "\uB0B4\uC720 \uC791\uC5C5\uD654"
    description: "\uAE30\uB984\uACFC \uB0C9\uAC01\uC218 \uC704\uC5D0\uC11C\uB3C4
      \uC798 \uBBF8\uB044\uB7EC\uC9C0\uC9C0 \uC54A\uB294 \uC791\uC5C5\uD654\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.mismatchedsafetyshoes
    name: "\uC9DD\uC774 \uB2E4\uB978 \uC548\uC804\uD654"
    description: "\uC11C\uB85C \uB2E4\uB978 \uC548\uC804\uD654\uB97C \uD55C \uC9DD\uC529
      \uC8FC\uC6E0\uC2B5\uB2C8\uB2E4. \uC774\uC0C1\uD558\uAC8C \uBCF4\uD3ED\uC740
      \uB354 \uC798 \uB9DE\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.boots.magneticlockboots
    name: "\uC790\uAE30 \uACE0\uC815 \uBD80\uCE20"
    description: "\uAC15\uD55C \uC790\uAE30\uC7A5\uC73C\uB85C \uBC14\uB2E5\uC744
      \uBD99\uC7A1\uC544 \uBC18\uB3D9\uACFC \uBBF8\uB044\uB7EC\uC9D0\uC744 \uC904\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.knightsboots
    name: "\uAE30\uC0AC\uC758 \uAD70\uD654"
    description: "\uC624\uB798\uB41C \uC758\uC7A5 \uAC11\uC8FC\uC758 \uAD70\uD654\uB97C
      \uACBD\uB7C9 \uAD6C\uB3D9\uAE30\uB85C \uBCF4\uAC15\uD588\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.boots.alienclaws
    name: "\uC6B0\uC8FC \uAD34\uBB3C \uBC1C\uD1B1"
    description: "\uC6B0\uC8FC \uC0DD\uBB3C\uC758 \uBC1C\uD1B1 \uC870\uC9C1\uC744
      \uBC11\uCC3D\uC5D0 \uACE0\uC815\uD574 \uC811\uC9C0\uB825\uC744 \uB192\uC600\uC2B5\uB2C8\uB2E4."
  - itemId: item.armor.boots.windsguidance
    name: "\uBC14\uB78C\uC758 \uC778\uB3C4"
    description: "\uC8FC\uBCC0 \uAE30\uB958\uB97C \uC77D\uC5B4 \uAC00\uC7A5 \uBE60\uB978
      \uBC1C\uD310\uC744 \uC54C\uB824 \uC8FC\uB294 \uBD80\uCE20\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.clownstrick
    name: "\uAD11\uB300\uC758 \uB18D\uAC04"
    description: "\uB2E4\uC74C \uBC1C\uC774 \uC5B4\uB514\uB85C \uD5A5\uD560\uC9C0
      \uCC29\uC6A9\uC790\uC870\uCC28 \uBAA8\uB974\uAC8C \uB9CC\uB4DC\uB294 \uC7A5\uB09C\uC2A4\uB7EC\uC6B4
      \uC2E0\uBC1C\uC785\uB2C8\uB2E4."
  - itemId: item.armor.boots.emergencyescapethrusters
    name: "\uBE44\uC0C1 \uD0C8\uCD9C \uCD94\uC9C4\uAE30"
    description: "\uC0DD\uC874 \uD655\uB960\uC774 \uAE09\uAC10\uD560 \uB54C\uB9CC
      \uC548\uC804\uC7A5\uCE58\uAC00 \uD480\uB9AC\uB294 \uBE44\uC0C1 \uCD94\uC9C4
      \uBD80\uCE20\uC785\uB2C8\uB2E4."
  - itemId: item.relic.cushioncore
    name: "\uCFE0\uC158 \uCF54\uC5B4"
    description: "\uCDA9\uACA9 \uD761\uC218 \uC824\uB85C \uAC10\uC2FC \uC800\uCD9C\uB825
      \uCF54\uC5B4\uC785\uB2C8\uB2E4. \uC131\uB2A5\uBCF4\uB2E4 \uB9C8\uC74C\uC774
      \uD3B8\uC548\uD574\uC9D1\uB2C8\uB2E4."
  - itemId: item.relic.maintenancedronecore
    name: "\uC815\uBE44 \uB4DC\uB860\uC758 \uCF54\uC5B4"
    description: "\uB178\uB798\uD558\uB4EF \uBE44\uD504\uC74C\uC744 \uB0B4\uB358
      \uC815\uBE44 \uB4DC\uB860\uC758 \uCF54\uC5B4\uC785\uB2C8\uB2E4. \uC544\uC9C1
      \uC218\uB9AC \uBA85\uB839\uC744 \uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - itemId: item.relic.depletedcore
    name: "\uBC29\uC804\uB41C \uCF54\uC5B4"
    description: "300\uB144 \uB3D9\uC548 \uBC29\uC804\uB41C \uCC44 \uBC30\uC1A1\uB418\uB358
      \uCF54\uC5B4\uC785\uB2C8\uB2E4. \uC544\uC8FC \uC57D\uD55C \uC794\uB958 \uC804\uB958\uAC00
      \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4."
  - itemId: item.relic.scrapcubecore
    name: "\uACE0\uCCA0 \uD050\uBE0C \uCF54\uC5B4"
    description: "\uC555\uCD95\uB41C \uACE0\uCCA0 \uD050\uBE0C \uC548\uC5D0\uC11C
      \uC2A4\uC2A4\uB85C \uD615\uD0DC\uB97C \uC720\uC9C0\uD558\uB294 \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  - itemId: item.relic.luckycharm
    name: "\uD589\uC6B4\uC758 \uBD80\uC801"
    description: "\uC5EC\uB7EC \uC2A4\uCE90\uBE48\uC800\uAC00 \uCC28\uB840\uB85C
      \uBAA9\uC5D0 \uAC78\uC5C8\uB358 \uB0A1\uC740 \uBD80\uC801\uC785\uB2C8\uB2E4.
      \uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uC758 \uC218\uB294 \uC54C\uB824\uC838
      \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - itemId: item.relic.abandonedfactorymanagerkey
    name: "\uD3D0\uACF5\uC7A5 \uAD00\uB9AC\uC790 \uD0A4"
    description: "\uD3D0\uACF5\uC7A5\uC758 \uBAA8\uB4E0 \uBB38\uC744 \uC5F4 \uC218
      \uC788\uC5C8\uB2E4\uB294 \uAD00\uB9AC\uC790 \uD0A4\uC785\uB2C8\uB2E4. \uC9C0\uAE08\uB3C4
      \uC77C\uBD80 \uC2DC\uC2A4\uD15C\uC774 \uC8FC\uC778\uC744 \uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - itemId: item.relic.alienheart
    name: "\uC6B0\uC8FC \uAD34\uBB3C \uC2EC\uC7A5"
    description: "\uBA48\uCD98 \uB4A4\uC5D0\uB3C4 \uC8FC\uBCC0\uC758 \uC0DD\uCCB4
      \uC5D0\uB108\uC9C0\uB97C \uB04C\uC5B4\uB2F9\uAE30\uB294 \uC6B0\uC8FC \uC0DD\uBB3C\uC758
      \uC2EC\uC7A5\uC785\uB2C8\uB2E4."
  - itemId: item.relic.dimensionalcompass
    name: "\uCC28\uC6D0\uC758 \uB098\uCE68\uBC18"
    description: "\uBD81\uCABD \uB300\uC2E0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uBD88\uC548\uC815\uD55C
      \uCC28\uC6D0\uC744 \uAC00\uB9AC\uD0A4\uB294 \uB098\uCE68\uBC18\uC785\uB2C8\uB2E4."
  - itemId: item.weapon.blunt.fryingpan
    name: "\uD504\uB77C\uC774\uD32C"
    description: "\uC694\uB9AC \uB3C4\uAD6C\uC785\uB2C8\uB2E4. \uC801\uC774 \uCDA9\uBD84\uD788
      \uC775\uC5C8\uB294\uC9C0 \uB450\uB4DC\uB824 \uD655\uC778\uD560 \uB54C\uB3C4
      \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - itemId: item.potion.blue
    name: "\uD30C\uB780 \uBB3C\uC57D"
    description: "\uC774\uB3D9\uC18D\uB3C4\uB97C \uC62C\uB824\uC8FC\uB294 \uD3EC\uC158\uC785\uB2C8\uB2E4."
  - itemId: item.potion.fire
    name: "\uD654\uC5FC \uBB3C\uC57D"
    description: "\uD654\uC5FC \uD53C\uD574 \uBCF4\uB108\uC2A4\uB97C 15 \uC62C\uB824\uC90D\uB2C8\uB2E4."
  - itemId: item.potion.ice
    name: "\uB0C9\uAE30 \uBB3C\uC57D"
    description: "\uB0C9\uAE30 \uD53C\uD574 \uBCF4\uB108\uC2A4\uB97C 15 \uC62C\uB824\uC90D\uB2C8\uB2E4."
  - itemId: item.potion.electric
    name: "\uC804\uACA9 \uBB3C\uC57D"
    description: "\uC804\uACA9 \uD53C\uD574 \uBCF4\uB108\uC2A4\uB97C 15 \uC62C\uB824\uC90D\uB2C8\uB2E4."
  - itemId: item.relic.gravityfieldcore
    name: "\uC911\uB825\uC7A5 \uC0DD\uC131 \uCF54\uC5B4"
    description: "\uC8FC\uBCC0 \uACF5\uAC04\uC744 \uB4A4\uD2C0\uC5B4 \uC778\uACF5
      \uC911\uB825\uC7A5\uC744 \uBC1C\uC0DD\uC2DC\uD0A4\uB294 \uC2E4\uD5D8\uC6A9
      \uCF54\uC5B4\uC785\uB2C8\uB2E4."
  engLabels:
  - itemId: item.weapon.greatsword.basic
    name: Basic Greatsword
    description: An ordinary greatsword.
  - itemId: item.weapon.shotgun.flamethrower
    name: Flamethrower
    description: Sprays flames in multiple directions.
  - itemId: item.weapon.blunt.mechanicaldestroyer
    name: Mechanical Destroyer
    description: A weapon capable of mercilessly destroying even the toughest machines.
  - itemId: item.weapon.blunt.treebranch
    name: Tree Branch
    description: A stick you could easily find lying on the ground.
  - itemId: item.armor.helmet.basic
    name: Basic Helmet
    description: An ordinary helmet.
  - itemId: item.armor.chest.sturdy
    name: Sturdy Armor
    description: A tough suit of armor.
  - itemId: item.armor.boots.ninja_movement
    name: Ninja's Movement
    description: Specialized combat footwear designed to reproduce the footwork of
      a legendary ninja.
  - itemId: item.armor.boots.quantum_shoes
    name: Quantum Shoes
    description: Footwear equipped with high technology.
  - itemId: item.potion.red
    name: Red Potion
    description: A potion.
  - itemId: item.relic.mass-produced_core
    name: Mass-Produced Core
    description: A machine core stamped out in a factory.
  - itemId: item.relic.advanced_core
    name: Advanced Core
    description: A core with higher output than an ordinary one.
  - itemId: item.weapon.blunt.noentrysign
    name: No Entry Sign
    description: Hehe, no entry.
  - itemId: item.weapon.axe.icecrusher
    name: Ice Crusher
    description: A mighty axe imbued with intense cold.
  - itemId: item.weapon.axe.inferno
    name: Inferno
    description: The flames within this axe bring hell to its enemies.
  - itemId: item.weapon.blunt.baseballbat
    name: Baseball Bat
    description: A baseball bat modified for combat.
  - itemId: item.weapon.blunt.lightsaber
    name: Lightsaber
    description: A lightsaber.
  - itemId: item.weapon.greatsword.crusader
    name: Crusader
    description: A greatsword capable of delivering a holy strike.
  - itemId: item.weapon.greatsword.guardiansjustice
    name: Guardian's Justice
    description: Justice always prevails!
  - itemId: item.weapon.blunt.ironpipe
    name: Iron Pipe
    description: A rusty pipe taken from a scrapyard.
  - itemId: item.relic.cybernetic_core
    name: Cybernetic Core
    description: An augmentation core wired directly into the nervous system.
  - itemId: item.weapon.greatsword.energyblade
    name: Energy Blade
    description: "E=mc\xB2. This blade quietly proves just how dangerous that equation
      can be."
  - itemId: item.weapon.greatsword.zeroblade
    name: Zero Blade
    description: Emits a cooling field approaching absolute zero.
  - itemId: item.weapon.greatsword.solarblade
    name: Solar Blade
    description: A plasma blade modeled after the Sun's nuclear fusion.
  - itemId: item.weapon.greatsword.voltblade
    name: Volt Blade
    description: Compresses millions of volts of electric potential into a single
      edge.
  - itemId: item.weapon.axe.heartofdebris
    name: Heart of Debris
    description: A legendary weapon forged from the condensed crystals of Debris-9.
  - itemId: item.weapon.greatsword.wasteheatcleaver
    name: Wasteheat Cleaver
    description: A massive blade that concentrates waste heat along its edge, allowing
      it to cut through even the toughest machinery.
  - itemId: item.weapon.axe.wildfire
    name: WildFire
    description: An axe that holds an undying ember. With every swing, its dormant
      heat flares to life.
  - itemId: item.weapon.blunt.thighbone
    name: Thighbone
    description: The femur of an unidentified space monster. It's far heavier and
      tougher than any bone has a right to be.
  - itemId: item.weapon.blunt.superrefrigerant
    name: Super Refrigerant
    description: Contains a cryogenic refrigerant. Every impact mercilessly drains
      heat from its surroundings.
  - itemId: item.weapon.blunt.morningstar
    name: Morning Star
    description: A weapon named after the brightest star of the dawn. Its victims
      may see a few stars of their own.
  - itemId: item.weapon.blunt.magicstaff
    name: Magic (Physical) Staff
    description: 'A magic staff that requires no mana. The incantation is simple:
      swing it as hard as you can.'
  - itemId: item.weapon.greatsword.nightsword
    name: Night Sword
    description: A greatsword blackened as though it had swallowed the light. In
      darkness, even the edge becomes difficult to discern.
  - itemId: item.weapon.greatsword.rusty
    name: Rusty GreatSword
    description: An old greatsword, rusted and dull.
  - itemId: item.armor.boots.discardedboostermodule
    name: Discarded Booster Module
    description: A booster module salvaged from discarded mobility gear. It failed
      the safety standards, but certainly not the speed standards.
  - itemId: item.armor.helmet.signaljammer
    name: Swarm Signal Jammer
    description: A device that injects random noise into nearby swarm communication
      signals. It confuses the enemy and gives the wearer a slight headache.
  - itemId: item.armor.chest.solargrace
    name: Solar Grace
    description: Armor that absorbs solar energy to protect its wearer. For a blessing
      from a star, it's surprisingly hot.
  - itemId: item.weapon.axe.phaseharvester
    name: Phasae Harvester
    description: A heavy cutting weapon that projects a high-frequency phase field
      along its blade. Even reinforced armor becomes fragile when its molecular bonds
      begin to destabilize.
  - itemId: item.weapon.greatsword.arcblade
    name: Arc Blade
    description: A combat blade that circulates high-voltage current along its edge.
      Electricity discharged through the cut can reach circuitry deep inside the
      target.
  - itemId: item.weapon.greatsword.corebreaker
    name: Corebreaker
    description: "A heavy weapon that releases the output of its central power core
      across the blade on impact. Breaking the outer armor is only the first step\u2014the
      real target is the power core beneath it."
  - itemId: item.weapon.greatsword.chainsaw
    name: ChainSaw
    description: An industrial saw designed to cut apart the armor of decommissioned
      robots. Battlefield testing revealed that waiting for official decommissioning
      was entirely optional.
  - itemId: item.weapon.blunt.shovel
    name: Shovel
    description: A multipurpose heavy tool once used by field maintenance crews.
      Machines that resist conventional repairs tend to become quiet after sufficient
      kinetic energy is applied.
  - itemId: item.armor.helmet.improvisedheadguard
    name: Improvised Headguard
    description: A makeshift headguard assembled from whatever materials were available.
      It is not exactly reliable, but it beats having no protection at all.
  - itemId: item.armor.chest.woodenarmor
    name: Wooden Armor
    description: Armor made by fastening several wooden plates together. It will
      not stop much firepower, but it can soften lighter impacts.
  - itemId: item.armor.helmet.steelheadguard
    name: Steel Headguard
    description: A headguard made from thin steel plates fitted around the head.
      Heavier than improvised gear, but considerably tougher.
  - itemId: item.armor.chest.steelarmor
    name: Steel Armor
    description: Simple armor constructed from overlapping steel plates. It offers
      a better chance of taking a robot's attack head-on.
  - itemId: item.armor.helmet.cauldronhelmet
    name: Cauldron Helmet
    description: A helmet made by wearing a thick metal cauldron upside down. Somehow,
      it seems better suited to this purpose than its original one.
  - itemId: item.armor.chest.basic
    name: Basic Armor
    description: An ordinary armor.
  - itemId: item.armor.boots.basic
    name: Basic Boots
    description: An ordinary boots.
  - itemId: item.armor.boots.lightweight
    name: Lightweight Safety Boots
    description: Work boots lightened by removing unnecessary protective plates.
  - itemId: item.armor.boots.poweredassist
    name: Powered Assist Boots
    description: Work boots equipped with compact actuators that assist the wearer's
      steps. Designed for carrying heavy loads, they also work surprisingly well
      for moving quickly.
  - itemId: item.relic.scrapcompactor
    name: Scrap Compactor
    description: A device that compresses and recycles debris from destroyed machines.
      The battlefield provides no shortage of raw material.
  - itemId: item.relic.overclockcore
    name: Overclock Core
    description: A modified power core that pushes its output beyond safe limits.
      Greater performance always comes at a cost.
  - itemId: item.weapon.greatsword.conveyercleaver
    name: Conveyor Cleaver
    description: A cutter blade was stripped from an abandoned factory conveyor and
      fitted with a grip. The safety guard was discarded to save weight.
  - itemId: item.weapon.greatsword.sharpgreatsword
    name: Sharp Greatsword
    description: A weighty greatsword with a properly honed edge. At least this one
      was actually made for cutting.
  - itemId: item.weapon.greatsword.ceremonialsword
    name: Ceremonial Sword
    description: A ceremonial sword used at the opening of Simon's factory. Its edge
      remained keen after the speeches ended.
  - itemId: item.weapon.greatsword.magneticrailblade
    name: Magnetic Railblade
    description: A magnetic rail drives electrical arcs along the blade, increasing
      its cutting force.
  - itemId: item.weapon.greatsword.simonslastcontract
    name: Simon's Last Contract
    description: A greatsword with the contract Simon signed when purchasing the
      planet sealed between its armor plates.
  - itemId: item.weapon.greatsword.planetdeedbreaker
    name: Planet Deedbreaker
    description: An enormous thermal greatsword seemingly built to shred planetary
      deeds.
  - itemId: item.weapon.blunt.torquewrench
    name: Torque Wrench
    description: An oversized maintenance wrench. Push it past the rated torque and
      most problems come apart.
  - itemId: item.weapon.blunt.managerriotbaton
    name: Manager's Riot Baton
    description: A riot baton issued to the abandoned factory's manager in case of
      unrest.
  - itemId: item.weapon.blunt.hydraulicpiledriver
    name: Hydraulic Pile Driver
    description: A demolition tool whose hydraulic cylinder drives a steel pin forward
      on impact.
  - itemId: item.weapon.blunt.magneticstormhammer
    name: Magnetic Storm Hammer
    description: A coil hammer charged inside a magnetic storm. The air rings before
      every strike lands.
  - itemId: item.weapon.blunt.refunddenied
    name: Refund Denied
    description: The final answer once used at William Corporation's refund desk.
  - itemId: item.weapon.blunt.lastwarningbell
    name: Final Warning Bell
    description: A huge bell once used to signal the end of a shift. It now ends
      the enemy's shift as well.
  - itemId: item.weapon.axe.emergencyrescueaxe
    name: Emergency Rescue Axe
    description: A full-size two-handed rescue axe taken from an emergency cabinet.
      Doors and robots open in much the same way.
  - itemId: item.weapon.axe.scrapsorter
    name: Scrap Sorter
    description: A cutter from the scrap-sorting line rebuilt into an axe.
  - itemId: item.weapon.axe.excavatortooth
    name: Excavator Tooth
    description: An axe made from the worn bucket tooth of an excavator.
  - itemId: item.weapon.axe.maintenancedronewing
    name: Maintenance Drone Wing
    description: The wing frame of a broken maintenance drone rebuilt into a double-edged
      axe.
  - itemId: item.weapon.axe.antimattersplitter
    name: Antimatter Splitter
    description: An experimental axe that confines matter that must never meet on
      opposite sides of its blade.
  - itemId: item.weapon.axe.finalinvoice
    name: Final Invoice
    description: An executioner's axe found beside an invoice listing Simon's final
      unpaid debt.
  - itemId: item.armor.helmet.foilsignalcap
    name: Foil Signal Cap
    description: A cap layered from food-grade foil and scrap wire. It blocks signals,
      but not stares.
  - itemId: item.armor.helmet.crackedweldingmask
    name: Cracked Welding Mask
    description: A work mask scarred by welding sparks and a prominent crack.
  - itemId: item.armor.helmet.reinforcedironmask
    name: Reinforced Iron Mask
    description: An iron mask reinforced with scrap plates and an additional impact
      layer.
  - itemId: item.armor.helmet.preciousmetaldetector
    name: Precious-Metal Detector
    description: A detector more responsive to live power cores than to precious
      metals.
  - itemId: item.armor.helmet.militaryneuralstimulator
    name: Military Neural Stimulator
    description: It overamplifies neural signals to force military-grade reaction
      speed.
  - itemId: item.armor.helmet.unbearablestimulation
    name: Unbearable Stimulation
    description: A neural stimulator with every safety limit removed. The body moves
      before thought can catch up.
  - itemId: item.armor.helmet.incomprehensiblefear
    name: Incomprehensible Fear
    description: An unidentified device that converts the wearer's fear response
      into combat predictions.
  - itemId: item.armor.helmet.alienskullcrown
    name: Alien Skull Crown
    description: Sensors and crown-shaped electrodes have been implanted into an
      alien creature's skull.
  - itemId: item.armor.chest.burnedmaintenancecoat
    name: Burned Maintenance Coat
    description: A maintenance coat salvaged from a fire. The fiber layers beneath
      the soot still hold.
  - itemId: item.armor.chest.packagingfoamarmor
    name: Packaging-Foam Armor
    description: Armor made from compressed layers of packing foam. It is warmer
      and tougher than it looks.
  - itemId: item.armor.chest.ballisticfibersuit
    name: Ballistic Fiber Suit
    description: A practical suit with high-density ballistic fibers sewn into its
      workwear lining.
  - itemId: item.armor.chest.spacemarinearmor
    name: Space Marine Armor
    description: Orbital marine armor plates reassembled to fit a scavenger's frame.
  - itemId: item.armor.chest.alienobservationsuit
    name: Alien Observation Suit
    description: A sealed observation suit designed to block alien fluids and spores.
  - itemId: item.armor.chest.energyarmor
    name: Energy Armor
    description: A compact generator deploys an energy shield at the moment of impact.
  - itemId: item.armor.chest.antimatterarmor
    name: Antimatter Armor
    description: Its containment layer deflects attacks while slowly eroding the
      wearer's vital signs.
  - itemId: item.armor.chest.portalcloak
    name: Portal Cloak
    description: An experimental cloak whose micro-portals divert incoming attack
      paths.
  - itemId: item.armor.boots.oilproofworkboots
    name: Oilproof Work Boots
    description: Work boots that keep their grip on oil and coolant.
  - itemId: item.armor.boots.mismatchedsafetyshoes
    name: Mismatched Safety Shoes
    description: Two different safety shoes found separately. Somehow, they match
      the wearer's stride better.
  - itemId: item.armor.boots.magneticlockboots
    name: Magnetic-Lock Boots
    description: Strong magnetic locks grip the floor, reducing recoil and slippage.
  - itemId: item.armor.boots.knightsboots
    name: Knight's Boots
    description: Boots from an old ceremonial suit of armor reinforced with lightweight
      actuators.
  - itemId: item.armor.boots.alienclaws
    name: Alien Claws
    description: Alien claw tissue fixed to the soles to improve traction.
  - itemId: item.armor.boots.windsguidance
    name: Wind's Guidance
    description: Boots that read nearby air currents and reveal the fastest footing.
  - itemId: item.armor.boots.clownstrick
    name: Clown's Trick
    description: Mischievous shoes that keep even their wearer guessing where the
      next step will land.
  - itemId: item.armor.boots.emergencyescapethrusters
    name: Emergency Escape Thrusters
    description: Emergency thrust boots whose safety locks release only when survival
      odds collapse.
  - itemId: item.relic.cushioncore
    name: Cushion Core
    description: A low-output core wrapped in impact-absorbing gel. It offers more
      peace of mind than power.
  - itemId: item.relic.maintenancedronecore
    name: Maintenance Drone Core
    description: The core of a maintenance drone that beeped like it was singing.
      It still remembers its repair orders.
  - itemId: item.relic.depletedcore
    name: Depleted Core
    description: A core that spent three hundred years in transit without power.
      A faint residual current remains.
  - itemId: item.relic.scrapcubecore
    name: Scrap Cube Core
    description: A core that maintains its own shape inside a cube of compressed
      scrap.
  - itemId: item.relic.luckycharm
    name: Lucky Charm
    description: A worn charm passed from one scavenger's neck to another. Nobody
      knows how many of them survived.
  - itemId: item.relic.abandonedfactorymanagerkey
    name: Abandoned Factory Manager Key
    description: A manager key said to have opened every door in the factory. Some
      systems still recognize its owner.
  - itemId: item.relic.alienheart
    name: Alien Heart
    description: An alien heart that continues drawing in nearby biological energy
      even after stopping.
  - itemId: item.relic.dimensionalcompass
    name: Dimensional Compass
    description: A compass that points toward the nearest unstable dimension instead
      of north.
  - itemId: item.weapon.blunt.fryingpan
    name: Frying Pan
    description: A cooking utensil. It also works for tapping enemies to check whether
      they're done.
  - itemId: item.potion.blue
    name: Blue Potion
    description: A potion that increases movement speed.
  - itemId: item.potion.fire
    name: Fire Potion
    description: Increases fire damage bonus by 15.
  - itemId: item.potion.ice
    name: Ice Potion
    description: Increases ice damage bonus by 15.
  - itemId: item.potion.electric
    name: Electric Potion
    description: Increases electric damage bonus by 15.
  - itemId: item.relic.gravityfieldcore
    name: Gravity Field Core
    description: An experimental core that warps the surrounding space to generate
      an artificial gravity field.
  jpnLabels:
  - itemId: item.weapon.greatsword.basic
