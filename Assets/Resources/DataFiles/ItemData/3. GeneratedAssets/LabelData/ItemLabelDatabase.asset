  - itemId: item.weapon.blunt.noentrysign
    name: "\u9032\u5165\u7981\u6B62\u6A19\u8B58"
    description: "\u3078\u3078\u3063\u3001\u901A\u884C\u7981\u6B62\u3060\u3002"
  - itemId: item.weapon.axe.icecrusher
    name: "\u30A2\u30A4\u30B9\u30AF\u30E9\u30C3\u30B7\u30E3\u30FC"
    description: "\u5F37\u70C8\u306A\u51B7\u6C17\u3092\u5BBF\u3057\u305F\u65A7\u3067\u3059\u3002"
  - itemId: item.weapon.axe.inferno
    name: "\u30A4\u30F3\u30D5\u30A7\u30EB\u30CE"
    description: "\u3053\u306E\u65A7\u306B\u5BBF\u308B\u708E\u306F\u3001\u6575\u306B\u5730\u7344\u3092\u3082\u305F\u3089\u3057\u307E\u3059\u3002"
  - itemId: item.weapon.blunt.baseballbat
    name: "\u91CE\u7403\u30D0\u30C3\u30C8"
    description: "\u91CE\u7403\u306E\u30D0\u30C3\u30C8\u3092\u6226\u95D8\u7528\u306B\u6539\u9020\u3057\u307E\u3057\u305F\u3002"
  - itemId: item.weapon.blunt.lightsaber
    name: "\u30E9\u30A4\u30C8\u30BB\u30FC\u30D0\u30FC"
    description: "\u30E9\u30A4\u30C8\u30BB\u30FC\u30D0\u30FC\u3067\u3059\u3002"
  - itemId: item.weapon.greatsword.crusader
    name: "\u30AF\u30EB\u30BB\u30A4\u30C0\u30FC"
    description: "\u8056\u306A\u308B\u4E00\u6483\u3092\u653E\u3066\u308B\u5927\u5263\u3067\u3059\u3002"
  - itemId: item.weapon.greatsword.guardiansjustice
    name: "\u5B88\u8B77\u8005\u306E\u6B63\u7FA9"
    description: "\u6B63\u7FA9\u306F\u5FC5\u305A\u52DD\u3064\uFF01"
  - itemId: item.weapon.blunt.ironpipe
    name: "\u9244\u30D1\u30A4\u30D7"
    description: "\u5EC3\u54C1\u51E6\u7406\u5834\u304B\u3089\u6301\u3063\u3066\u304D\u305F\u9306\u3073\u305F\u9244\u30D1\u30A4\u30D7\u3067\u3059\u3002"
  - itemId: item.relic.cybernetic_core
    name: "\u30B5\u30A4\u30D0\u30CD\u30C6\u30A3\u30C3\u30AF\u30B3\u30A2"
    description: "\u795E\u7D4C\u7CFB\u306B\u76F4\u63A5\u63A5\u7D9A\u3055\u308C\u308B\u5F37\u5316\u30B3\u30A2\u3067\u3059\u3002"
  - itemId: item.weapon.greatsword.energyblade
    name: "\u30A8\u30CD\u30EB\u30AE\u30FC\u30D6\u30EC\u30FC\u30C9"
    description: "E=mc\xB2\u3002\u3053\u306E\u5263\u306F\u3001\u305D\u306E\u516C\u5F0F\u304C\u3069\u308C\u307B\u3069\u5371\u967A\u304B\u3092\u9759\u304B\u306B\u8A3C\u660E\u3059\u308B\u3002"
  - itemId: item.weapon.greatsword.zeroblade
    name: "\u30BC\u30ED\u30D6\u30EC\u30FC\u30C9"
    description: "\u7D76\u5BFE\u96F6\u5EA6\u306B\u8FD1\u3044\u51B7\u5374\u5834\u3092\u653E\u51FA\u3057\u307E\u3059\u3002"
  - itemId: item.weapon.greatsword.solarblade
    name: "\u30BD\u30FC\u30E9\u30FC\u30D6\u30EC\u30FC\u30C9"
    description: "\u592A\u967D\u306E\u6838\u878D\u5408\u3092\u6A21\u5023\u3057\u305F\u30D7\u30E9\u30BA\u30DE\u30D6\u30EC\u30FC\u30C9\u3067\u3059\u3002"
  - itemId: item.weapon.greatsword.voltblade
    name: "\u30DC\u30EB\u30C8\u30D6\u30EC\u30FC\u30C9"
    description: "\u6570\u767E\u4E07\u30DC\u30EB\u30C8\u306E\u96FB\u4F4D\u3092\u4E00\u672C\u306E\u5203\u306B\u5727\u7E2E\u3057\u307E\u3057\u305F\u3002"
  - itemId: item.weapon.axe.heartofdebris
    name: "\u30C7\u30D6\u30EA\u30B9\u306E\u5FC3\u6838"
    description: "\u30C7\u30D6\u30EA\u30B99\u306E\u7D50\u6676\u3092\u51DD\u7E2E\u3057\u3066\u9020\u3089\u308C\u305F\u4F1D\u8AAC\u306E\u6B66\u5668\u3002"
  - itemId: item.weapon.greatsword.wasteheatcleaver
    name: "\u5EC3\u71B1\u65AD\u88C1\u5927\u5263"
    description: "\u5203\u306B\u5EC3\u71B1\u3092\u96C6\u4E2D\u3055\u305B\u3001\u5F37\u56FA\u306A\u6A5F\u68B0\u3059\u3089\u65AD\u3061\u5207\u308B\u5927\u5263\u3002"
  - itemId: item.weapon.axe.wildfire
    name: "\u30EF\u30A4\u30EB\u30C9\u30D5\u30A1\u30A4\u30A2"
    description: "\u6D88\u3048\u308B\u3053\u3068\u306E\u306A\u3044\u706B\u7A2E\u3092\u5BBF\u3057\u305F\u65A7\u3002\u632F\u308B\u3046\u305F\u3073\u3001\u7720\u3063\u3066\u3044\u305F\u71B1\u304C\u518D\u3073\u71C3\u3048\u4E0A\u304C\u308B\u3002"
  - itemId: item.weapon.blunt.thighbone
    name: "\u5B87\u5B99\u602A\u7269\u306E\u5927\u817F\u9AA8"
    description: "\u6B63\u4F53\u4E0D\u660E\u306E\u5B87\u5B99\u602A\u7269\u304B\u3089\u53D6\u308C\u305F\u5927\u817F\u9AA8\u3002\u9AA8\u3068\u306F\u601D\u3048\u306A\u3044\u307B\u3069\u91CD\u304F\u3001\u9811\u4E08\u3060\u3002"
  - itemId: item.weapon.blunt.superrefrigerant
    name: "\u8D85\u51B7\u5A92"
    description: "\u6975\u4F4E\u6E29\u306E\u51B7\u5A92\u304C\u5C01\u3058\u8FBC\u3081\u3089\u308C\u3066\u3044\u308B\u3002\u885D\u6483\u3092\u53D7\u3051\u308B\u305F\u3073\u3001\u5468\u56F2\u306E\u71B1\u3092\u5BB9\u8D66\u306A\u304F\u596A\u3044\u53D6\u308B\u3002"
  - itemId: item.weapon.blunt.morningstar
    name: "\u660E\u3051\u306E\u660E\u661F"
    description: "\u660E\u3051\u65B9\u306E\u7A7A\u3067\u6700\u3082\u660E\u308B\u304F\u8F1D\u304F\u661F\u306E\u540D\u3092\u6301\u3064\u6B66\u5668\u3002\u6BB4\u3089\u308C\u305F\u76F8\u624B\u3082\u3001\u3057\u3070\u3089\u304F\u661F\u3092\u898B\u308B\u3053\u3068\u306B\u306A\u308B\u3002"
  - itemId: item.weapon.blunt.magicstaff
    name: "\u9B54\u6CD5\uFF08\u7269\u7406\uFF09\u306E\u6756"
    description: "\u9B54\u529B\u304C\u306A\u304F\u3066\u3082\u4F7F\u3048\u308B\u9B54\u6CD5\u306E\u6756\u3002\u546A\u6587\u306F\u7C21\u5358\u3060\u3002\u529B\u3044\u3063\u3071\u3044\u632F\u308A\u56DE\u305B\u3002"
  - itemId: item.weapon.greatsword.nightsword
    name: "\u591C\u306E\u5203"
    description: "\u5149\u3092\u98F2\u307F\u8FBC\u3093\u3060\u304B\u306E\u3088\u3046\u306B\u9ED2\u304F\u67D3\u307E\u3063\u305F\u5927\u5263\u3002\u95C7\u306E\u4E2D\u3067\u306F\u3001\u305D\u306E\u5203\u306E\u5883\u754C\u3059\u3089\u66D6\u6627\u306B\u306A\u308B\u3002"
  - itemId: item.weapon.greatsword.rusty
    name: "\u9306\u3073\u305F\u5927\u5263"
    description: "\u9306\u3073\u3064\u304D\u3001\u5203\u3082\u920D\u3063\u305F\u53E4\u3044\u5927\u5263\u3002\u3053\u306E\u91CD\u3055\u306A\u3089\u3001\u5225\u306B\u92ED\u304F\u306A\u304F\u3066\u3082\u554F\u984C\u306A\u3044\u3002"
  - itemId: item.armor.boots.discardedboostermodule
    name: "\u5EC3\u68C4\u3055\u308C\u305F\u30D6\u30FC\u30B9\u30BF\u30FC\u30E2\u30B8\u30E5\u30FC\u30EB"
    description: "\u5EC3\u68C4\u3055\u308C\u305F\u6A5F\u52D5\u88C5\u5099\u304B\u3089\u53D6\u308A\u5916\u3057\u305F\u30D6\u30FC\u30B9\u30BF\u30FC\u30E2\u30B8\u30E5\u30FC\u30EB\u3002\u5B89\u5168\u57FA\u6E96\u306F\u6E80\u305F\u3057\u3066\u3044\u306A\u3044\u304C\u3001\u901F\u5EA6\u306B\u95A2\u3057\u3066\u306F\u6587\u53E5\u306A\u3057\u3060\u3002"
  - itemId: item.armor.helmet.signaljammer
    name: "\u7FA4\u4F53\u4FE1\u53F7\u30B8\u30E3\u30DE\u30FC"
    description: "\u5468\u56F2\u306E\u7FA4\u4F53\u901A\u4FE1\u4FE1\u53F7\u306B\u30E9\u30F3\u30C0\u30E0\u306A\u30CE\u30A4\u30BA\u3092\u6DF7\u305C\u8FBC\u3080\u88C5\u7F6E\u3002\u6575\u306F\u6DF7\u4E71\u3057\u3001\u88C5\u7740\u8005\u306F\u5C11\u3057\u982D\u304C\u75DB\u304F\u306A\u308B\u3002"
  - itemId: item.armor.chest.solargrace
    name: "\u592A\u967D\u306E\u6069\u5BF5"
    description: "\u592A\u967D\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u5438\u53CE\u3057\u3001\u88C5\u7740\u8005\u3092\u5B88\u308B\u93A7\u3002\u661F\u304B\u3089\u6388\u304B\u308B\u6069\u5BF5\u306B\u3057\u3066\u306F\u3001\u304B\u306A\u308A\u71B1\u3044\u3002"
  - itemId: item.weapon.axe.phaseharvester
    name: "\u4F4D\u76F8\u53CE\u7A6B\u6A5F"
