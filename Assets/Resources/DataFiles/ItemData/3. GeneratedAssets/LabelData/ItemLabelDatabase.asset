  - itemId: item.armor.boots.quantum_shoes
    name: "\u30AF\u30A1\u30F3\u30BF\u30E0\u30B7\u30E5\u30FC\u30BA"
    description: "\u30CF\u30A4\u30C6\u30AF\u30CE\u30ED\u30B8\u30FC\u304C\u642D\u8F09\u3055\u308C\u305F\u9774\u3067\u3059\u3002"
  - itemId: item.potion.red
    name: "\u8D64\u3044\u30DD\u30FC\u30B7\u30E7\u30F3"
    description: "\u30DD\u30FC\u30B7\u30E7\u30F3\u3067\u3059\u3002"
  - itemId: item.relic.mass-produced_core
    name: "\u91CF\u7523\u578B\u30B3\u30A2"
    description: "\u5DE5\u5834\u3067\u5927\u91CF\u751F\u7523\u3055\u308C\u305F\u6A5F\u68B0\u88C5\u7F6E\u306E\u30B3\u30A2\u3067\u3059\u3002"
  - itemId: item.relic.advanced_core
    name: "\u9AD8\u7D1A\u30B3\u30A2"
