      \uC0B4 \uC218 \uC5C6\uB294 \uBC84\uB824\uC9C4 \uB545\uC774\uC5C8\uC9C0\uB9CC,
      \uC218\uBC31 \uB144\uAC04 \uC313\uC778 \uB85C\uBD07 \uC794\uD574\uB4E4\uC774
      \uC2A4\uC2A4\uB85C\uB97C \uBCF5\uAD6C\uD558\uACE0 \uAC1C\uC870\uD558\uAE30
